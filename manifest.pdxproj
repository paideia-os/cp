# cp -- paideia-as build manifest
#
# Wave: R90-XREPO  Milestone: v1.3.0 (outer TXN wrap, paideia-os/cp#35)
#
# v1.3.0 adds src/pdxfs_txn.pdx (5 trampolines against the landed R90
# KIND_PDXFS_TXN substrate: pdxfs_txn_begin/bind/add_write/commit/
# abort, sysnos 70/104/105/107 -- see that file's header for the full
# sysno reconciliation) and wraps CopyFile::copy_bytes_only's read/
# write loop in a best-effort outer TXN. No loader-side KIND_PDXFS_VOL
# slot-discovery mechanism exists yet, so pdxfs_txn_begin is called
# with a stub parent_slot and is expected to fail today; any failure
# degrades cleanly to the pre-#35 non-transactional body.
#
# Wave: R50  Milestone: v1.2.0 (Wave D drain close-out)
#
# v1.2.0 closes the paideia-os/cp Wave D drain:
#
#   paideia-os/cp#31 -- caps.decl adds KIND_PDXFS_VOL declaration +
#                       adoption note (R90-XREPO.013.M3-003).
#   paideia-os/cp#32 -- v1.1-A real-body extraction (verified already
#                       landed at beecb0c; closed with cite).
#   paideia-os/cp#33 -- v1.1-B semantic-pipe emission: CopyRecord@0.1
#                       via sys_semantic_send (sysno 115, R107-M0-001
#                       paideia-os #2350) at the successful-exit tail
#                       of copy_bytes_only.
#   paideia-os/cp#34 -- v1.1-C release closer: manifest version bump,
#                       manifest.pdxsig alignment, CHANGELOG
#                       consolidation, PDX_TOOL_NAME/PDX_TOOL_VERSION
#                       externs for the libpdx-argv 1.1.3 Wave 6
#                       contract.
#   paideia-os/cp#36 -- regression test: dst-basename-only path
#                       relative to cwd (v1.1-B contract).
#
# v1.1-C (2026-09-12) closed paideia-os/cp#23 (`cp.ENH-007 TXN
# begin/commit/abort are no-ops while the docs assert atomicity as
# fact`) as a doc-only landing. v1.2.0 preserves that doc audit and
# adds one new source module (src/pipe.pdx), one new tool-identity
# stub (src/tool_ident.pdx), and one regression test
# (tests/dst_basename_smoke.pdx).
#
# v1.1-B closes paideia-os/cp#21: the kernel's vfs_open O_CREAT
# parent-scan refuses a slash-less create outright, so
# `cd /home/alice && cp notes.md backup.md` failed with exit 1 under
# v1.1-A. v1.1-B adds sys_getcwd (SC+ ID 86) and resolves the
# destination path against the task cwd in userspace BEFORE the
# O_CREAT sys_open call site -- matching the mkdir v1.1-B precedent
# (paideia-os/mkdir#25). Absolute destinations pass through unchanged.
#
# v1.1-A retired the M1-001 STUB shape shipped by cp v1.0 -- the
# KIND_PDXFS_TXN begin/commit/abort trio, the libpdx-audit + libpdx-
# elevate + libpdx-semantic-pipe wire-ins, the recursive walker, the
# --over-existing undo record path, and the cap-tail signed-inode
# preservation -- all of which were shape-in-place stubs against
# not-yet-landed substrates. What shipped in v1.1-A is a five-syscall
# real body: sys_open + sys_read + sys_write + sys_close + sys_stat.
# v1.1-B extends that surface to six syscalls by adding sys_getcwd.
#
# Consumed by `paideia-as build`. Each line is a directive; blank
# lines and lines starting with `#` are ignored. paideia-as v0.36+
# is the required toolchain floor (mov_b + mov_d narrow-load
# mnemonics + @align attribute on .bss slots).
#
# The build produces one output file at build-out/cp (the elaborated
# .pdx -> ELF-like Paideia binary) plus a caps-manifest copy at
# build-out/cp.caps for the InitCap sidecar packaging step.

name        = cp
version     = 1.3.0
kind        = tool
entry       = Main::cp_main
output      = build-out/cp
caps_decl   = caps.decl
sig_file    = manifest.pdxsig
doc_file    = doc/cp.pdxdoc

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). -----------------
#
# v1.2.0 source count: 7 (v1.1-B: 5). Added modules:
#   pipe.pdx         -- CopyRecord@0.1 emission via sys_semantic_send
#                       (sysno 115, R107-M0-001 #2350) -- REAL body,
#                       replaces the v1.0 libpdx-semantic-pipe stub
#                       retired at v1.1-A; the module name reuses
#                       "pipe.pdx" but the record shape (24 bytes,
#                       CopyRecord@0.1 vs the v1.0 CopyProgressRecord
#                       schema) is a fresh design.
#   tool_ident.pdx   -- PDX_TOOL_NAME + PDX_TOOL_VERSION externs per
#                       the Wave 6 libpdx-argv v1.1.3 contract
#                       (ENH-032); resolved at link time by
#                       VersionBackend::emit_default.
#
# Retired (v1.1-A): flags.pdx / walk.pdx / signed_inode.pdx / undo.pdx /
# audit.pdx / elevate.pdx. The v1.0 pipe.pdx was retired at v1.1-A and
# the v1.2.0 replacement is a fresh design against the sys_semantic_
# send substrate that has since landed.
sources:
  - src/print.pdx        # sys_write(fd=1/2) helper
  - src/pdxfs.pdx        # sys_open/read/write/close/stat/getcwd trampolines
  - src/pdxfs_txn.pdx    # outer TXN trampolines: begin/bind/add_write/commit/abort (cp#35)
  - src/copy.pdx         # real-body single-file copy (stat + open + loop + close + pipe emit + TXN wrap)
  - src/dispatch.pdx     # pos_count validate + route to copy body
  - src/main.pdx         # cp_main(argc, argv) entry point
  - src/pipe.pdx         # CopyRecord@0.1 semantic-pipe emit (sysno 115)
  - src/tool_ident.pdx   # PDX_TOOL_NAME / PDX_TOOL_VERSION (Wave 6)

# --- Library dependencies -----------------------------------------------
# v1.1-A collapses the v1.0 dep list from four libraries to one:
#
#   libpdx-argv           -- StdVocab + FlagSpec + Parser + ParsedArgs.
#
# Retired: libpdx-semantic-pipe (CopyProgressRecord bind + emit),
#          libpdx-audit (CopyRecord begin/commit wrap),
#          libpdx-elevate (cross-subtree dst-parent retry).
deps:
  - libpdx-argv @ ^0.2

# --- Paideia-as compliance flags ---------------------------------------
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm <= 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call
