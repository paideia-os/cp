# cp — paideia-as build manifest
#
# Wave: R50  Milestone: M1 (design + skeleton)
# Doc:   design/tooling/r49-r50-plan.md §5.6 in the paideia-os repo.
#
# Consumed by `paideia-as build`. Each line is a directive; blank lines
# and lines starting with `#` are ignored. The M1 format is deliberately
# minimal — one target, one entry point, a source list, a dep list, and
# the caps-manifest that ships in the packaged binary. paideia-as v0.33+
# is the required toolchain floor (mov_b narrow-load mnemonic + @align
# attribute on .bss slots per the #1248 mitigation).
#
# The build produces one output file at build-out/cp (the elaborated
# .pdx → ELF-like Paideia binary) plus a caps-manifest copy at
# build-out/cp.caps for the InitCap sidecar packaging step at M5.

name        = cp
version     = 0.1.0-m1
kind        = tool
entry       = CpMain::cp_main
output      = build-out/cp
caps_decl   = caps.decl

# --- Source list (order-insensitive; paideia-as resolves module deps
# from `module <Basename> = structure { ... }` headers). -----------------
#
# Grouped by the M1 issue that adds each file:
#   M1-002 lands: print, dispatch, main (argv surface + flag gate).
#   M1-003 lands: pdxfs, copy (first-runnable single-file copy).
sources:
  - src/print.pdx                 # M1-002 sys_write(fd=1/2) helper
  - src/pdxfs.pdx                 # M1-003 open/read/write/close + TXN stubs
  - src/copy.pdx                  # M1-003 single-file copy body
  - src/dispatch.pdx              # M1-002 flag gate + positional-count validate
  - src/main.pdx                  # M1-002 cp_main(argc, argv) entry point

# --- Library dependencies -----------------------------------------------
# Only libpdx-argv at M1 (main uses it to parse the argv surface). The
# other four shared libraries land later:
#   libpdx-semantic-pipe → M3-001 (CopyProgressRecord[] emit)
#   libpdx-audit         → M3-002 (CopyRecord pre-output journal)
#   libpdx-elevate       → M3-003 (cross-subtree elevate retry)
#   libpdx-cap           → M2 (signed-inode preservation via caps_decl_verify
#                              at exec; M1 verify is loader-side stubbed).
deps:
  - libpdx-argv @ ^0.1

# --- Paideia-as compliance flags ---------------------------------------
# These mirror the invariants every R49/R50 tool observes and every M1
# file in this repo is written against. Documented here so a build under
# a non-conforming paideia-as revision refuses fast.
compliance:
  - module-basename-pascal        # Module <BasenamePascalCase>, no dir prefix
  - no-test-mnemonic              # zero-check via cmp reg, 0
  - cmp-imm32-only                # cmp reg, imm ≤ 0x7FFFFFFF; else stage via r11
  - r11-scratch                   # r11 is not preserved across calls
  - byte-load-zero-then-mov_b     # xor rax, rax; mov_b rax, [ptr]
  - sysv-push-pop-parity          # rsp % 16 == 0 at every nested call
