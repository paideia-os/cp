// src/main.pdx — cp.M1-002 + cp.M2-001 (typed flag registration)
//                + cp.M3-001 (semantic-pipe schema bind)
//                + cp.M3-002 (audit state reset)
//                + cp.M3-003 (elevate state reset)
// CpMain module: cp_main(argc, argv) entry point.
//
// Scope
// -----
// The paideia-as loader stub reads argc/argv from the stack per the
// SysV/x86_64 convention and calls cp_main(argc in rdi, argv in rsi);
// cp_main's return value is the process exit code the loader stub
// passes to sys_exit (paideia-os syscall #60).
//
// Flow (M3):
//   1. FlagSpec::reset()                — clear libpdx-argv's typed-flag
//                                          registration table.
//   2. StdVocab::register_all()         — register the 9 standard flags.
//   3. CpFlags::register_cp_flags()     — register cp's own three flag
//                                          names: -r, -v, --over-existing.
//   4. ParsedArgs::reset()              — zero libpdx-argv's parse state.
//   5. CpPipe::cp_pipe_reset()          — M3-001 counter baseline.
//   6. CpAudit::cp_audit_reset()        — M3-002 audit-id baseline.
//   7. CpElevate::cp_elevate_reset()    — M3-003 elevate-counter baseline.
//   8. Parser::parse_argv(argv, argc)   — walk argv into ParsedArgs.
//      If it returns non-zero, print a short usage line on stderr
//      and return exit code 2 (usage error).
//   9. CpPipe::cp_pipe_bind_stdout()    — M3-001 bind fd 1 to the
//                                          CopyProgressRecord@0.1 schema
//                                          hash. Idempotent; bind failure
//                                          bumps pipe_bind_errors but
//                                          does NOT abort — the emit path
//                                          is gated internally via
//                                          SP_SEND_ERR_NOT_BOUND.
//  10. Dispatch::dispatch_copy()        — mirrors CpFlags, validates
//                                          positional count, wraps the
//                                          whole invocation in the M3-002
//                                          audit begin/commit pair, and
//                                          routes to Walk::walk_recursive
//                                          (-r) or CopyFile::copy_single_file.
//  11. Return the dispatch call's exit code.
//
// paideia-as compliance
// ---------------------
//   - Module CpMain (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF.
//   - r11 is scratch; used in every lea for the .rodata parse-fail
//     message base.
//   - 2-push prologue (rbx, r12) + a reserved 8-byte pad keeps
//     rsp%16 == 0 at every nested call site. See the register-plan
//     comment on cp_main below.
//
// Cross-module externs consumed
// -----------------------------
//   FlagSpec::reset              (libpdx-argv)
//   StdVocab::register_all       (libpdx-argv)
//   CpFlags::register_cp_flags   (this repo, src/flags.pdx)
//   ParsedArgs::reset            (libpdx-argv)
//   Parser::parse_argv           (libpdx-argv)
//   Dispatch::dispatch_copy      (this repo, src/dispatch.pdx)
//   Print::print_err             (this repo, src/print.pdx)
//   CpPipe::cp_pipe_reset        (this repo, src/pipe.pdx)   [M3-001]
//   CpPipe::cp_pipe_bind_stdout  (this repo, src/pipe.pdx)   [M3-001]
//   CpAudit::cp_audit_reset      (this repo, src/audit.pdx)  [M3-002]
//   CpElevate::cp_elevate_reset  (this repo, src/elevate.pdx) [M3-003]

module CpMain = structure {

  // -- Local diagnostic strings -----------------------------------------
  // Emitted when libpdx-argv reports a parse error. A later milestone
  // replaces this with a `doc cp --help` invocation; M1 keeps the
  // message small and hand-rolled so cp has no dep on `doc` at M1.
  pub let PARSE_FAIL_MSG : [u8; 39] =
    "cp: argv parse error (run 'cp --help')\n"
  pub let PARSE_FAIL_MSG_LEN : u64 = 39

  // ============================================================================
  // cp_main(argc, argv) -> exit_code
  //
  // Signature: cp_main : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): argc — number of argv entries
  // RSI (input): argv — pointer to a u64 array of NUL-terminated arg ptrs
  // RAX (output): exit code (0 ok / 1 op-fail / 2 usage / 3 not-yet-impl /
  //                          4 cap-denied [reserved])
  //
  // Register plan (2-push + 8-byte reserved pad frame):
  //   rbx = argv        (preserved across every nested call)
  //   r12 = argc        (preserved across every nested call)
  //   [rsp + 0] = pad   (keeps rsp%16 == 0 at every nested call site)
  //   rax = call return / temp
  //   rdi, rsi = nested-call arg carriers
  //   r11 = lea scratch
  //
  // rsp arithmetic:
  //   caller-of-cp_main:   rsp % 16 == 0 immediately before call
  //   after CALL:          rsp % 16 == 8  (return address pushed)
  //   after push rbx:      rsp % 16 == 0
  //   after push r12:      rsp % 16 == 8
  //   after sub rsp, 8:    rsp % 16 == 0  ← every nested call ok
  //   epilogue reverses.
  //
  // Note: cp_main preserves argc/argv in rbx/r12 across the
  // Parser::parse_argv call even though libpdx-argv does not read them
  // back from those regs. The preservation is defensive: it costs one
  // extra prologue instruction and makes the parse-fail diagnostic
  // path free to touch argc/argv (e.g. for a future "argv[error_arg_
  // index]" render — libpdx-argv already stores error_arg_index in
  // ParsedArgs).
  // ============================================================================
  pub let cp_main : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (argc: u64) (argv: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp.M1-002 cp_main + cp.M2-001 typed-flag registration + cp.M3-001 pipe-schema-bind + cp.M3-002 audit-state-reset + cp.M3-003 elevate-state-reset. Entry point invoked by the paideia-as loader stub with argc in rdi + argv in rsi. Flow: reset libpdx-argv registration table → register standard + cp-owned flags → reset argv parse state → reset M3 module counters (pipe/audit/elevate) → parse via libpdx-argv → bind stdout to CopyProgressRecord@0.1 schema hash → hand off to Dispatch::dispatch_copy. 2-push prologue (rbx=argv, r12=argc) plus a `sub rsp, 8` reserved pad keeps rsp%16 == 0 at every nested call site (10 calls now: 3 registration + 4 reset + 1 parse + 1 pipe-bind + 1 dispatch, plus the optional print_err on the parse-fail path). rbx/r12 preserved across every nested call — the callee-save contract from SysV holds through libpdx-argv (Parser::parse_argv, ParsedArgs::reset, FlagSpec::reset are leaf; StdVocab::register_all, CpFlags::register_cp_flags declare their own 1-push alignment). The three M3 reset calls (cp_pipe_reset, cp_audit_reset, cp_elevate_reset) are leaves. cp_pipe_bind_stdout is non-leaf (1-push shape) but respects SysV callee-save so rbx/r12 survive. Parse-fail path: print PARSE_FAIL_MSG on stderr; return EXIT_USAGE. Otherwise: cp_pipe_bind_stdout (return code ignored — bind failure is recoverable via SP_SEND_ERR_NOT_BOUND handling at emit); then tail-call-in-body-shape into Dispatch::dispatch_copy whose return value is our own. All immediates within cmp reg,imm ≤ 0x7FFFFFFF. Return: pop the pad, pop r12, pop rbx, ret with rax carrying the dispatched body's exit code (or 2 on parse-fail).",
      block: {
        // Prologue: preserve argc/argv, align stack.
        push rbx;                              // rsp%16: 8 → 0
        push r12;                              // rsp%16: 0 → 8
        sub rsp, 8;                            // rsp%16: 8 → 0

        mov rbx, rsi;                          // rbx = argv
        mov r12, rdi;                          // r12 = argc

        // Step 1: reset FlagSpec and register the standard + cp flags.
        call FlagSpec::reset;
        call StdVocab::register_all;
        call CpFlags::register_cp_flags;

        // Step 2: reset libpdx-argv parse state.
        call ParsedArgs::reset;

        // Step 2a (M3): reset the M3 module counters. All three are
        // leaves; they only zero counter .bss slots and do not touch
        // any argv-derived state so ordering vs parse is irrelevant.
        call CpPipe::cp_pipe_reset;
        call CpAudit::cp_audit_reset;
        call CpElevate::cp_elevate_reset;

        // Step 3: parse. rdi = argv, rsi = argc.
        mov rdi, rbx;
        mov rsi, r12;
        call Parser::parse_argv;

        // Step 4: check parse error. rax == 0 (ERR_OK) → continue.
        cmp rax, 0;
        je cp_main_parse_ok;

        // Parse failed: print diagnostic, return EXIT_USAGE.
        lea rdi, [rip + PARSE_FAIL_MSG];
        mov rsi, 39;                           // PARSE_FAIL_MSG_LEN
        call Print::print_err;

        mov rax, 2;                            // EXIT_USAGE
        jmp cp_main_epilogue;

      cp_main_parse_ok:
        // Step 4a (M3-001): bind stdout (fd 1) to the CopyProgressRecord@0.1
        // schema hash. Bind is idempotent for the same (fd, hash) pair —
        // safe on a re-execve. Return code is intentionally ignored: bind
        // failure bumps CpPipe::pipe_bind_errors and the downstream emit
        // path (cp_pipe_emit_progress) reduces to a counter bump via
        // SP_SEND_ERR_NOT_BOUND translation, so cp continues to copy
        // bytes even without a bound stdout schema.
        call CpPipe::cp_pipe_bind_stdout;

        // Step 5: dispatch. dispatch_copy wraps the whole invocation in
        // the M3-002 audit begin/commit pair, opens the M2-004 outer
        // TXN, and routes to Walk::walk_recursive (-r) or
        // CopyFile::copy_single_file.
        call Dispatch::dispatch_copy;
        // rax now carries dispatch's exit code; fall through.

      cp_main_epilogue:
        // Restore stack, return with rax carrying the exit code.
        add rsp, 8;                            // undo pad
        pop r12;
        pop rbx;
        ret
      }
    }
}
