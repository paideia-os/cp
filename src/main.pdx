// src/main.pdx -- cp v1.1-A (real-body entry point)
// CpMain module: cp_main(argc, argv) entry point.
//
// Scope (v1.1-A)
// --------------
// The paideia-as loader stub reads argc/argv from the stack per the
// SysV/x86_64 convention and calls cp_main(argc in rdi, argv in rsi);
// cp_main's return value is the process exit code the loader stub
// passes to sys_exit (paideia-os syscall #60).
//
// Retires the v1.0 M1-001 STUB shape (cp_pipe_reset, cp_audit_reset,
// cp_elevate_reset, copy_reset, walk_reset, undo_reset,
// signed_inode_reset, register_cp_flags, cp_pipe_bind_stdout -- all
// of them shape-in-place wire-ins against not-yet-landed
// substrates). What remains is exactly the argv-parse pipeline plus
// the dispatch call:
//
//   1. FlagSpec::reset             -- clear libpdx-argv's flag table.
//   2. StdVocab::register_all      -- register the standard vocabulary
//                                      (--help, --version, --dry-run,
//                                      --json, --schema, --verbose,
//                                      --quiet, --color, --no-cap).
//                                      No cp-owned flags at v1.1-A;
//                                      register_cp_flags retires.
//   3. ParsedArgs::reset           -- zero libpdx-argv's parse state.
//   4. Parser::parse_argv(argv, argc) -- walk argv into ParsedArgs.
//      Non-zero return means a parse error: print a short diagnostic
//      on stderr and return exit code 2 (usage error).
//   5. Dispatch::dispatch_copy     -- validate pos_count and call
//                                      copy_bytes_only. Its return is
//                                      our return.
//
// StdVocab registration is retained even though v1.1-A wires none of
// its flags -- keeping the standard vocabulary means `cp --help` and
// `cp --version` parse without error rather than hitting the
// unknown-flag branch, matching every other R49/R50 tool's parse
// surface. A future v1.2 wires --help through doc/cp.pdxdoc.
//
// Cross-module externs consumed
// -----------------------------
//   FlagSpec::reset          (libpdx-argv)
//   StdVocab::register_all   (libpdx-argv)
//   ParsedArgs::reset        (libpdx-argv)
//   Parser::parse_argv       (libpdx-argv)
//   Dispatch::dispatch_copy  (this repo, src/dispatch.pdx)
//   Print::print_err         (this repo, src/print.pdx)
//
// paideia-as compliance (v0.36+)
// ------------------------------
//   - Module CpMain (PascalCase basename matches src/main.pdx).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm <= 0x7FFFFFFF.
//   - r11 is scratch (every lea for .rodata parse-fail message).
//   - 2-push prologue (rbx=argv, r12=argc) + reserved 8-byte pad
//     keeps rsp%16 == 0 at every nested call site.

module Main = structure {

  // -- Local diagnostic strings -----------------------------------------
  // Emitted when libpdx-argv reports a parse error.
  pub let PARSE_FAIL_MSG : [u8; 39] =
    "cp: argv parse error (run 'cp --help')\n"
  pub let PARSE_FAIL_MSG_LEN : u64 = 39

  // ============================================================================
  // cp_main(argc, argv) -> exit_code
  //
  // Signature: cp_main : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): argc -- number of argv entries
  // RSI (input): argv -- pointer to a u64 array of NUL-terminated arg ptrs
  // RAX (output): exit code -- 0 on success, 2 on parse/usage error, or
  //               a raw negative-errno u64 (bit 63 set) on copy failure.
  //
  // Register plan (2-push + 8-byte reserved pad frame):
  //   rbx = argv          (preserved across every nested call)
  //   r12 = argc          (preserved across every nested call)
  //   [rsp + 0] = pad     (keeps rsp%16 == 0 at every nested call site)
  //   rax = call return / temp
  //   rdi, rsi = nested-call arg carriers
  //   r11 = lea scratch
  //
  // rsp arithmetic:
  //   caller-of-cp_main:   rsp % 16 == 0 immediately before call
  //   after CALL:          rsp % 16 == 8  (return address pushed)
  //   after push rbx:      rsp % 16 == 0
  //   after push r12:      rsp % 16 == 8
  //   after sub rsp, 8:    rsp % 16 == 0  <- every nested call ok
  //   epilogue reverses.
  // ============================================================================
  pub let cp_main : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (argc: u64) (argv: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A cp_main. Entry point invoked by the paideia-as loader stub with argc in rdi + argv in rsi. Flow: reset libpdx-argv flag table -> register standard vocabulary -> reset argv parse state -> parse via libpdx-argv -> hand off to Dispatch::dispatch_copy. Retires the v1.0 M1-001 STUB shape's seven counter-resets (cp_pipe_reset, cp_audit_reset, cp_elevate_reset, copy_reset, walk_reset, undo_reset, signed_inode_reset), the register_cp_flags call (no cp-owned flags at v1.1-A -- -r/-v/--over-existing all retire with the stub-heavy body), and the cp_pipe_bind_stdout call (CopyProgressRecord schema binding retires with libpdx-semantic-pipe). 2-push prologue (rbx=argv, r12=argc) plus a `sub rsp, 8` reserved pad keeps rsp%16 == 0 at every nested call site (5 calls now: FlagSpec::reset, StdVocab::register_all, ParsedArgs::reset, Parser::parse_argv, Dispatch::dispatch_copy, plus the optional Print::print_err on the parse-fail path). rbx/r12 preserved across every nested call -- the callee-save contract from SysV holds through libpdx-argv. Parse-fail path: print PARSE_FAIL_MSG on stderr; return EXIT_USAGE=2. Otherwise return dispatch_copy's exit code (0 on success, 2 on wrong pos_count, or negative-errno u64 on copy failure). All immediates within cmp reg,imm <= 0x7FFFFFFF.",
      block: {
        // Prologue: preserve argc/argv, align stack.
        push rbx;                              // rsp%16: 8 -> 0
        push r12;                              // rsp%16: 0 -> 8
        sub rsp, 8;                            // rsp%16: 8 -> 0

        mov rbx, rsi;                          // rbx = argv
        mov r12, rdi;                          // r12 = argc

        // Step 1: reset FlagSpec and register the standard vocabulary.
        // No cp-owned flags at v1.1-A -- retires register_cp_flags.
        call reset;
        call register_all;

        // Step 2: reset libpdx-argv parse state.
        call reset;

        // Step 3: parse. rdi = argv, rsi = argc.
        mov rdi, rbx;
        mov rsi, r12;
        call parse_argv;

        // Step 4: check parse error. rax == 0 (ERR_OK) -> continue.
        cmp rax, 0;
        je cp_main_parse_ok;

        // Parse failed: print diagnostic, return EXIT_USAGE.
        lea rdi, [rip + PARSE_FAIL_MSG];
        mov rsi, 39;                           // PARSE_FAIL_MSG_LEN
        call print_err;

        mov rax, 2;                            // EXIT_USAGE
        jmp cp_main_epilogue;

      cp_main_parse_ok:
        // Step 5: dispatch. dispatch_copy validates pos_count and
        // routes to copy_bytes_only; its return is our return.
        call dispatch_copy;
        // rax now carries dispatch's exit code; fall through.

      cp_main_epilogue:
        // Restore stack, return with rax carrying the exit code.
        add rsp, 8;                            // undo pad
        pop r12;
        pop rbx;
        ret
      }
    }
}
