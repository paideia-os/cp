// src/copy.pdx — cp.M1-003 + cp.M2-004 (TXN-hoist extract)
//                + cp.M3-001 (CopyProgressRecord emit)
// CopyFile module: single-file copy body.
//
// Scope
// -----
// M1 first-runnable shape: `cp a b` opened the source read-only,
// opened the destination with O_CREAT | O_WRONLY, wrapped both opens
// between a pdxfs_txn_begin / pdxfs_txn_commit pair (M1 stubs),
// streamed bytes through a 4 KiB .bss scratch buffer until source
// EOF, closed both fds, committed, and returned 0.
//
// M2-004 hoists the KIND_PDXFS_TXN wrap to dispatch level so a
// single outer TXN spans the whole invocation — both single-file and
// recursive `-r` paths run inside one TXN, and any failure aborts
// every already-written destination byte at the TXN boundary
// (dispatch calls pdxfs_txn_abort on body-failure return). This
// module now exposes:
//
//   copy_bytes_only(src_ptr, dst_ptr) -> exit_code
//     M2-004 NEW. The M1 body minus the TXN begin/commit pair. Called
//     by dispatch's single-file arm and (once walk_entry_todo lands)
//     by Walk::walk_recursive per regular-file entry.
//
//   copy_single_file(src_ptr, dst_ptr) -> exit_code
//     Backward-compatible alias for copy_bytes_only. Kept because
//     documentation, tests, and the M1 callsite name reference it;
//     forwards to copy_bytes_only with no additional work.
//
// The M2-004 dispatch-level TXN wrap means the two TXN failure
// branches (copy_txn_begin_fail / copy_txn_commit_fail) migrate out
// of this file entirely — see Dispatch::dispatch_copy for the new
// begin/commit/abort call sites. This module's error branches are
// exclusively the read/write/short-write/open-src/open-dst family.
//
// Storage model
// -------------
// A 4 KiB scratch buffer lives in .bss (COPY_BUF). Each loop iteration
// does one pdxfs_read into it and one pdxfs_write out of it; the
// syscall count for a copy of N bytes is roughly 2 * ceil(N / 4096) +
// two opens + two closes + two txn calls. A 1 MiB file is ~514 total
// syscalls at M1.
//
// The two fd slots (fd_src, fd_dst) and the running bytes_copied
// counter also live in .bss. All three are singleton (one cp
// invocation is one copy).
//
// Register plan
// -------------
// 5-push prologue (rbx, r12, r13, r14, r15) lands rsp%16 == 0 at
// every nested call site. Every long-lived value crosses at least one
// pdxfs_* call and therefore lives in a callee-save reg:
//   rbx = src_ptr    (input; preserved across every call)
//   r12 = dst_ptr    (input; preserved across every call)
//   r13 = fd_src     (from pdxfs_open; preserved across every call)
//   r14 = fd_dst     (from pdxfs_open; preserved across every call)
//   r15 = last_n     (bytes returned by the current pdxfs_read; needed
//                     as the write-length for the matching pdxfs_write
//                     and as the short-write comparison target)
// Scratch: rax (return), rcx (bytes_copied accumulator load/store), rdi,
// rsi, rdx (syscall args), r11 (every lea).
//
// Cross-module externs consumed
// -----------------------------
//   Pdxfs::pdxfs_open, pdxfs_read, pdxfs_write, pdxfs_close
//   Pdxfs::pdxfs_txn_begin, pdxfs_txn_commit
//   Print::print_err
//   Undo::maybe_record_over_existing           (this repo)  [M2-005]
//   SignedInode::preserve_at_destination        (this repo)  [M2-002/003]
//   CpPipe::cp_pipe_emit_progress               (this repo)  [M3-001]
//   CpPipe::bytes_copied (via .bss read)        (this repo)  [M3-001]
//
// paideia-as compliance
// ---------------------
//   - Module CopyFile (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (largest is COPY_BUF_LEN = 4096).
//     The negative-errno detection uses `cmp rax, 0; jl` (signed
//     compare against 0) which sets the SF flag from bit 63 of rax
//     without staging the negative sentinel as an immediate.
//   - r11 is scratch; used in every lea for .bss/.rodata addresses.
//   - Byte loads not needed here (copy body reads and writes at word
//     granularity through syscall boundaries; no byte-load pattern).
//   - 5-push prologue, rsp%16 == 0 at every nested call site; matching
//     5-pop epilogue with rax carrying the exit code.

module CopyFile = structure {

  // -- Buffer + counter storage ----------------------------------------
  // COPY_BUF_LEN kept at 4096 for a good syscall-count / .bss-pressure
  // trade-off. A larger buffer amortises the syscall overhead but pins
  // more .bss for a small-file-typical workload; 4 KiB matches the
  // typical page-size fingerprint.
  pub let COPY_BUF_LEN : u64 = 4096

  pub let mut copy_buf     : [u8; 4096] = uninit @align(8)
  pub let mut fd_src       : u64        = uninit @align(8)
  pub let mut fd_dst       : u64        = uninit @align(8)
  pub let mut bytes_copied : u64        = uninit @align(8)

  // -- Diagnostic strings ---------------------------------------------
  // Every error path prints one line on stderr and returns 1. Kept
  // small so a script's stderr capture stays scannable; M3 replaces
  // these with libpdx-audit records that carry structured fields.
  pub let OPEN_SRC_FAIL_MSG : [u8; 28] =
    "cp: cannot open source file\n"
  pub let OPEN_SRC_FAIL_MSG_LEN : u64 = 28

  pub let OPEN_DST_FAIL_MSG : [u8; 33] =
    "cp: cannot open destination file\n"
  pub let OPEN_DST_FAIL_MSG_LEN : u64 = 33

  pub let READ_FAIL_MSG : [u8; 28] =
    "cp: read from source failed\n"
  pub let READ_FAIL_MSG_LEN : u64 = 28

  pub let WRITE_FAIL_MSG : [u8; 32] =
    "cp: write to destination failed\n"
  pub let WRITE_FAIL_MSG_LEN : u64 = 32

  pub let SHORT_WRITE_MSG : [u8; 47] =
    "cp: short write to destination (partial state)\n"
  pub let SHORT_WRITE_MSG_LEN : u64 = 47

  // Retained for source-level continuity across the M1→M2 transition;
  // the M2-004 dispatch-level TXN wrap means the TXN failure
  // diagnostics now emit from Dispatch::dispatch_copy (see
  // dispatch.pdx TXN_BEGIN_FAIL_MSG / TXN_COMMIT_FAIL_MSG). No M2
  // code path in this module emits either string.
  pub let TXN_BEGIN_FAIL_MSG : [u8; 29] =
    "cp: transaction begin failed\n"
  pub let TXN_BEGIN_FAIL_MSG_LEN : u64 = 29

  pub let TXN_COMMIT_FAIL_MSG : [u8; 30] =
    "cp: transaction commit failed\n"
  pub let TXN_COMMIT_FAIL_MSG_LEN : u64 = 30

  // ============================================================================
  // copy_reset()
  //
  // Signature: copy_reset : () -> () !{mem} @{}
  //
  // Clear the three .bss slots (fd_src, fd_dst, bytes_copied) so a
  // subsequent copy_single_file call starts from a known-zero
  // baseline. copy_buf is index-consumed (every write is preceded by
  // a read that overwrites it) so it does not need zeroing.
  //
  // Leaf; r11 scratch; no push/pop parity to preserve.
  // ============================================================================
  pub let copy_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp.M1-003 copy_reset. Zero the three .bss counter slots (fd_src, fd_dst, bytes_copied) so copy_single_file starts from a known baseline. copy_buf is index-consumed so trailing bytes do not need zeroing (same idiom as ParsedArgs::reset in libpdx-argv and PkgList::list_reset in pkg). r11 is scratch used only for the three leas. Leaf.",
      block: {
        xor rax, rax;
        lea r11, [rip + fd_src];       mov [r11], rax;
        lea r11, [rip + fd_dst];       mov [r11], rax;
        lea r11, [rip + bytes_copied]; mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // copy_bytes_only(src_ptr, dst_ptr) -> exit_code
  //
  // Signature: copy_bytes_only : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): src_ptr — VA of a NUL-terminated source path
  // RSI (input): dst_ptr — VA of a NUL-terminated destination path
  // RAX (output): 0 on success, 1 on any syscall error
  //
  // NEW at M2-004. The M1 copy_single_file body with the TXN begin /
  // commit pair removed (see file-header note on the M2-004 TXN hoist).
  // Dispatch::dispatch_copy now opens the outer TXN once per invocation
  // before calling this entry, and calls pdxfs_txn_abort on any body
  // failure. Walk::walk_recursive (once its per-entry body lands) calls
  // this same entry per regular-file entry, still inside the one outer
  // TXN.
  //
  // Body flow:
  //   1. copy_reset
  //   2. pdxfs_open(src_ptr, O_RDONLY = 0)             → r13 = fd_src
  //   3. pdxfs_open(dst_ptr, O_WRONLY|O_CREAT = 0x41)  → r14 = fd_dst
  //   4. Read/write loop until source EOF (n == 0).
  //   5. Close dst, close src (return codes ignored — an fd release
  //      error is not something cp's caller can act on).
  //   6. Return 0.
  //
  // Error branches
  // --------------
  //   copy_open_src_fail  — no fds open; print + return 1.
  //   copy_open_dst_fail  — close fd_src; print + return 1.
  //   copy_read_fail      — close fd_dst + fd_src; print + return 1.
  //   copy_write_fail     — close fd_dst + fd_src; print + return 1.
  //   copy_short_write    — close fd_dst + fd_src; print + return 1.
  //
  // Every error branch shares a single copy_epilogue so the 5-pop
  // teardown is expressed once. On error, control returns to
  // Dispatch::dispatch_copy with rax=1, which triggers the outer
  // pdxfs_txn_abort call — the partial destination bytes get unwound
  // at the TXN boundary.
  //
  // The two TXN failure branches from the M1 shape (copy_txn_begin_fail
  // and copy_txn_commit_fail) are migrated to dispatch.pdx at M2-004.
  //
  // Register plan (5-push prologue → rsp%16 == 0 at every nested call):
  //   rbx = src_ptr    (preserved across every call)
  //   r12 = dst_ptr    (preserved across every call)
  //   r13 = fd_src     (from pdxfs_open; preserved across every call)
  //   r14 = fd_dst     (from pdxfs_open; preserved across every call)
  //   r15 = last_n     (bytes returned by the current pdxfs_read; the
  //                     write-length for the matching pdxfs_write and
  //                     the short-write comparison target)
  // ============================================================================
  pub let copy_bytes_only : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp.M2-004 copy_bytes_only. The M1 copy_single_file body with the TXN begin/commit pair extracted to dispatch level (see cp.M2-004 file-header note). Open src (O_RDONLY=0), open dst (O_WRONLY|O_CREAT=0x41), stream through 4KiB .bss buffer copy_buf until EOF, close both, return 0. The outer KIND_PDXFS_TXN is opened once at Dispatch::dispatch_copy for the whole invocation (single-file or recursive) and closed with commit on success or abort on any body failure — so a partial write from this function unwinds at the TXN boundary without needing a per-function abort call. 5-push prologue (rbx=src_ptr, r12=dst_ptr, r13=fd_src, r14=fd_dst, r15=last_n) lands rsp%16==0 at every nested call site; every long-lived value crosses at least one pdxfs_* call and therefore lives in a callee-save reg. Five error branches (copy_open_src_fail / copy_open_dst_fail / copy_read_fail / copy_write_fail / copy_short_write) each close whatever fds are open (0/1/2 fds), print one line on stderr, and jump to copy_epilogue with rax=1. Success returns via xor rax,rax; jmp copy_epilogue. Every cmp reg,imm uses immediate ≤ 0x7FFFFFFF (0x40=O_CREAT / 0x41=O_WRONLY|O_CREAT / 4096=COPY_BUF_LEN). Negative-errno detection uses `cmp rax, 0; jl` (signed compare). sysreg effect for syscall clobber.",
      block: {
        // ---- Prologue --------------------------------------------------------
        push rbx;                              // rsp%16: 8 → 0
        push r12;                              // rsp%16: 0 → 8
        push r13;                              // rsp%16: 8 → 0
        push r14;                              // rsp%16: 0 → 8
        push r15;                              // rsp%16: 8 → 0

        mov rbx, rdi;                          // rbx = src_ptr
        mov r12, rsi;                          // r12 = dst_ptr

        // ---- Step 1: reset state --------------------------------------------
        call CopyFile::copy_reset;

        // ---- Step 2: open source (O_RDONLY = 0) -----------------------------
        mov rdi, rbx;                          // src_ptr
        mov rsi, 0;                            // O_RDONLY
        call Pdxfs::pdxfs_open;
        cmp rax, 0;
        jl copy_open_src_fail;

        mov r13, rax;                          // r13 = fd_src
        lea r11, [rip + fd_src];
        mov [r11], rax;

        // ---- Step 2a (M2-005): --over-existing undo capture -----------------
        // Journal the pre-copy destination state IFF cp was invoked
        // with --over-existing AND the destination file already exists.
        // Undo::maybe_record_over_existing does both gates internally;
        // its UNDO_OK return covers three cases:
        //   (a) --over-existing was not set (no-op),
        //   (b) destination does not exist (no-op),
        //   (c) undo record captured successfully.
        // Only UNDO_WRITE_ERR would abort the copy; the M2 stub never
        // returns that (the write path is stubbed to always succeed),
        // so no return-code gate is needed at M2. When the R42 undo-
        // write substrate lands, add cmp rax, 0; jne to a new
        // copy_undo_write_fail branch that jumps to copy_epilogue with
        // rax=1 (the outer dispatch-level TXN abort unwinds).
        mov rdi, r12;                          // dst_ptr
        call Undo::maybe_record_over_existing;

        // ---- Step 3: open destination (O_WRONLY | O_CREAT = 0x41) -----------
        mov rdi, r12;                          // dst_ptr
        mov rsi, 0x41;                         // O_WRONLY | O_CREAT
        call Pdxfs::pdxfs_open;
        cmp rax, 0;
        jl copy_open_dst_fail;

        mov r14, rax;                          // r14 = fd_dst
        lea r11, [rip + fd_dst];
        mov [r11], rax;

        // ---- Step 4: read/write loop ----------------------------------------
      copy_loop_head:
        // pdxfs_read(fd_src, copy_buf, COPY_BUF_LEN)
        mov rdi, r13;                          // fd_src
        lea rsi, [rip + copy_buf];             // buf
        mov rdx, 4096;                         // COPY_BUF_LEN
        call Pdxfs::pdxfs_read;

        cmp rax, 0;
        jl copy_read_fail;                     // negative errno → error
        je copy_eof;                           // n == 0 → source EOF, done

        mov r15, rax;                          // r15 = n (bytes read)

        // pdxfs_write(fd_dst, copy_buf, n)
        mov rdi, r14;                          // fd_dst
        lea rsi, [rip + copy_buf];             // buf
        mov rdx, r15;                          // len = n
        call Pdxfs::pdxfs_write;

        cmp rax, 0;
        jl copy_write_fail;                    // negative errno → error

        cmp rax, r15;                          // bytes_written < n?
        jl copy_short_write;                   // yes → short-write error

        // Accumulate bytes_copied += rax.
        lea r11, [rip + bytes_copied];
        mov rcx, [r11];
        add rcx, rax;
        mov [r11], rcx;

        jmp copy_loop_head;

        // ---- Step 5+6+7: success epilogue -----------------------------------
        // (EOF, close fds, preserve dst cap-tail, return 0)
      copy_eof:
        // Close dst first, then src. Return values ignored (a close
        // error on the M2 substrate is not something the caller can
        // do anything about; the fd is released at task teardown
        // regardless). The outer TXN commit happens in dispatch.
        mov rdi, r14;
        call Pdxfs::pdxfs_close;

        mov rdi, r13;
        call Pdxfs::pdxfs_close;

        // ---- Step 7 (M2-002): preserve destination cap-tail -----------------
        // Attempt to re-sign the destination inode under the invoker's
        // user_sk. SI_OK (0) and SI_DEGRADED_KEY_LOCKED (1) are both
        // success-continuation codes — the file bytes are copied either
        // way, only the inode signature differs. SI_ERROR (0xFFFFFFFF)
        // is fatal but the M2 stub never returns it (libpdx-cap.M3 body
        // edit lands the real re-sign path along with the SI_ERROR
        // failure mode). Consequently no return-code gate is needed
        // here at M2 — the call is fire-and-continue.
        mov rdi, r12;                          // dst_ptr
        call SignedInode::preserve_at_destination;

        // ---- Step 8 (M3-001): emit CopyProgressRecord on stdout -------------
        // rbx = src_path, r12 = dst_path (both preserved across the
        // read/write loop by the 5-push prologue). bytes_copied lives
        // in .bss; bytes_total == bytes_copied at M3 (a distinct total
        // arrives at M4 with pdxfs_stat integration). The emit return
        // is deliberately ignored — pipe_emit_errors is bumped
        // internally on failure but the byte content of the copy is
        // authoritative for cp semantics; a missing progress record
        // is a shape-in-place condition today (broker daemon not yet
        // running), not a copy failure.
        mov rdi, rbx;                          // src_path
        mov rsi, r12;                          // dst_path
        lea r11, [rip + bytes_copied];
        mov rdx, [r11];                        // bytes_copied
        mov rcx, rdx;                          // bytes_total = bytes_copied
        call CpPipe::cp_pipe_emit_progress;

        xor rax, rax;                          // EXIT_OK (0)
        jmp copy_epilogue;

        // ---- Error branches -------------------------------------------------
        // Ordered by "how many fds are open at this point":
        //   0 fds: copy_open_src_fail
        //   1 fd  (fd_src): copy_open_dst_fail
        //   2 fds:          copy_read_fail, copy_write_fail, copy_short_write
      copy_open_src_fail:
        lea rdi, [rip + OPEN_SRC_FAIL_MSG];
        mov rsi, 28;                           // OPEN_SRC_FAIL_MSG_LEN
        call Print::print_err;
        mov rax, 1;                            // EXIT_OP_FAIL
        jmp copy_epilogue;

      copy_open_dst_fail:
        // fd_src is open; close it before we return.
        mov rdi, r13;
        call Pdxfs::pdxfs_close;

        lea rdi, [rip + OPEN_DST_FAIL_MSG];
        mov rsi, 33;                           // OPEN_DST_FAIL_MSG_LEN
        call Print::print_err;
        mov rax, 1;
        jmp copy_epilogue;

      copy_read_fail:
        mov rdi, r14;
        call Pdxfs::pdxfs_close;
        mov rdi, r13;
        call Pdxfs::pdxfs_close;

        lea rdi, [rip + READ_FAIL_MSG];
        mov rsi, 28;                           // READ_FAIL_MSG_LEN
        call Print::print_err;
        mov rax, 1;
        jmp copy_epilogue;

      copy_write_fail:
        mov rdi, r14;
        call Pdxfs::pdxfs_close;
        mov rdi, r13;
        call Pdxfs::pdxfs_close;

        lea rdi, [rip + WRITE_FAIL_MSG];
        mov rsi, 32;                           // WRITE_FAIL_MSG_LEN
        call Print::print_err;
        mov rax, 1;
        jmp copy_epilogue;

      copy_short_write:
        mov rdi, r14;
        call Pdxfs::pdxfs_close;
        mov rdi, r13;
        call Pdxfs::pdxfs_close;

        lea rdi, [rip + SHORT_WRITE_MSG];
        mov rsi, 47;                           // SHORT_WRITE_MSG_LEN
        call Print::print_err;
        mov rax, 1;
        jmp copy_epilogue;

        // ---- Shared epilogue ------------------------------------------------
      copy_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // copy_single_file(src_ptr, dst_ptr) -> exit_code
  //
  // Signature: copy_single_file : (u64, u64) -> u64 !{mem, sysreg} @{}
  //
  // M1 entry-point name kept for backward source compatibility and for
  // the M4 test-target vocabulary. At M2-004 this is a thin forwarder:
  // it calls copy_bytes_only and returns its exit code untouched. The
  // TXN begin/commit that used to live here migrated to dispatch level
  // (see file-header M2-004 note).
  //
  // Non-leaf: 1-push prologue (rbx unused body-side; pushed to align
  // rsp%16 to 0 for the nested call).
  // ============================================================================
  pub let copy_single_file : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp.M2-004 copy_single_file forwarder. M1 entry-point name preserved for source-level continuity and M4 test-target vocabulary. At M2-004 the TXN begin/commit hoisted to dispatch level, leaving this function as a thin call-through to copy_bytes_only. 1-push prologue (rbx unused; for rsp alignment). Same signature + semantics as the M1 entry; the outer TXN wrap now lives at Dispatch::dispatch_copy.",
      block: {
        push rbx;                              // align rsp for nested call

        call CopyFile::copy_bytes_only;
        // rax carries copy_bytes_only's exit code (0 or 1).

        pop rbx;
        ret
      }
    }
}
