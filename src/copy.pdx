// src/copy.pdx -- cp v1.1-A (real body extraction)
// CopyFile module: single-file copy body.
//
// Scope (v1.1-A)
// --------------
// Retires the M1-001 STUB shape (cp v1.0's stub-heavy body wrapped in
// KIND_PDXFS_TXN begin/commit/abort stubs, libpdx-audit begin/commit
// wrap, libpdx-elevate retry, over-existing undo capture, cap-tail
// signed-inode preservation, and CopyProgressRecord pipe emit --
// every one of those was a shape-in-place stub on a not-yet-landed
// substrate). v1.1-A is a REAL BODY: five kernel syscalls, no stubs.
//
//   sys_open  (SC+ id 2)  -- source O_RDONLY + destination O_WRONLY|
//                             O_CREAT|O_TRUNC with the src stat's mode
//   sys_stat  (SC+ id 77) -- probe destination (is it a directory?),
//                             then read source (size + POSIX mode word)
//   sys_read  (SC+ id 0)  -- 4 KiB scratch buffer refill
//   sys_write (SC+ id 1)  -- 4 KiB scratch buffer drain
//   sys_close (SC+ id 3)  -- release both fds on every exit
//
// v1.1-A behaviour
// ----------------
//   argv: SRC DST.
//   1. sys_stat(DST). If DST resolves to a directory (POSIX mode with
//      S_IFDIR bits set) the effective destination becomes
//      DST + "/" + basename(SRC), built once in a .bss path buffer
//      (copy_dst_path). Any other stat result (ENOENT, ENOTDIR, mode
//      with no directory bits) leaves DST unchanged.
//   2. sys_stat(SRC). Extracts size (unused at v1.1-A -- the copy loop
//      terminates on read == 0 EOF, same shape as /bin/cp) and mode.
//      A mode of 0 (tmpfs's stat-adapter fills mode=0 today) defaults
//      to 0644 (0x1A4) so tmpfs targets still land at a sensible perm.
//   3. sys_open(SRC, O_RDONLY, 0).
//   4. sys_open(effective_DST, O_WRONLY|O_CREAT|O_TRUNC = 0xC1,
//                              src_mode).
//   5. read/write loop over the 4 KiB scratch buffer until source EOF.
//   6. sys_close(dst); sys_close(src) -- returns ignored (fd release on
//      task teardown is authoritative).
//   7. Return 0 on success. On any syscall failure return the raw
//      -errno u64 from the failing syscall verbatim (bit 63 set); the
//      caller detects errors with `cmp rax, 0; jl err` per the paideia-
//      os error-return convention.
//
// Deliberately NOT in v1.1-A
// --------------------------
//   -r    recursive walk (Walk module retired with the M1-001 STUB)
//   -p    permission preservation beyond the source mode (v1.2 lands
//         atime/mtime/uid/gid preservation once the substrate exposes
//         sys_utimes and sys_chown)
//   -i    interactive overwrite confirmation (out of scope for a
//         non-interactive R50 tool)
//   --over-existing / undo journalling
//   --dry-run
//   libpdx-audit / libpdx-elevate / libpdx-semantic-pipe wire-in
//
// All of the above lived in cp v1.0 as shape-in-place stubs against
// not-yet-landed substrates; v1.1-A drops the stubs and their dead
// call sites rather than continuing to ship code that never runs.
//
// Storage model
// -------------
// Five .bss singletons:
//
//   copy_buf         [u8; 4096]  -- read/write scratch (one refill per
//                                    loop iteration)
//   copy_dst_path    [u8; 512]   -- constructed dst path when DST is a
//                                    directory (dst_dir + '/' +
//                                    basename(src) + '\0')
//   copy_src_stat    [u8; 64]    -- sys_stat destination for SRC
//   copy_dst_stat    [u8; 64]    -- sys_stat destination for DST probe
//   fd_src / fd_dst / bytes_copied  u64 counters (diagnostic only)
//
// Register plan (5-push prologue -> rsp%16 == 0 at every nested call)
// -------------------------------------------------------------------
//   rbx = src_ptr (Phase 1-3; dead by open-src). Reused Phase 5+ as
//         bytes-read n across the pdxfs_write call.
//   r12 = dst_ptr (Phase 1-4; may be rewritten to &copy_dst_path).
//         Dead by open-dst.
//   r13 = src mode word (Phase 3-4; dead after open-dst). Free
//         thereafter.
//   r14 = fd_src (from open-src through close in every arm).
//   r15 = fd_dst (from open-dst through close in every arm).
//   rax = call return / temp
//   rcx = accumulator scratch (bytes_copied +=)
//   rdi, rsi, rdx = nested-call arg carriers
//   r11 = scratch for every lea against a .bss / .rodata base
//
// paideia-as compliance (v0.36+)
// ------------------------------
//   - Module Copy (PascalCase basename matches src/copy.pdx).
//   - No test mnemonic; every zero-check via `cmp reg, 0`.
//   - Every `cmp reg, imm` uses immediate <= 0x7FFFFFFF (largest is
//     0x4000 for the S_IFDIR mask and 0xC1 for the open-dst flags).
//   - Larger immediates (S_IFMT = 0xF000, mode default 0x1A4, ...)
//     that need to appear as compare operands are staged through r11.
//     Move-immediates that need > 0x7FFFFFFF widths use `mov r64,
//     imm64` (movabs, encoded automatically by paideia-as).
//   - r11 is scratch (every lea for .bss / .rodata addresses).
//   - Byte loads via `xor rax, rax; mov_b rax, [reg+ofs]`. u32 mode
//     read uses `mov_d rax, [reg+ofs]` (the frozen zero-extended-load
//     mnemonic).
//   - Negative-errno detection uses `cmp rax, 0; jl` (signed compare).
//   - Reserved-label prefixes: `cp_` for copy_bytes_only, `cjb_` for
//     copy_join_dir_basename (avoids `loop`/`done`/`top` collisions).
//   - Every function ends in a matching pop-then-ret.
//
// Cross-module externs consumed
// -----------------------------
//   Pdxfs::pdxfs_open  (path, flags, mode) -- 3-arg since v1.1-A
//   Pdxfs::pdxfs_read  (fd, buf, len)
//   Pdxfs::pdxfs_write (fd, buf, len)
//   Pdxfs::pdxfs_close (fd)
//   Pdxfs::pdxfs_stat  (path, statbuf)
//   Print::print_err   (buf, len)

module Copy = structure {

  // -- Buffer + counter storage ----------------------------------------
  pub let COPY_BUF_LEN      : u64 = 4096
  pub let COPY_DST_PATH_LEN : u64 = 512
  pub let COPY_STAT_LEN     : u64 = 64

  pub let mut copy_buf      : [u8; 4096] = uninit @align(8)
  pub let mut copy_dst_path : [u8; 512]  = uninit @align(8)
  pub let mut copy_src_stat : [u8; 64]   = uninit @align(8)
  pub let mut copy_dst_stat : [u8; 64]   = uninit @align(8)

  pub let mut fd_src        : u64 = uninit @align(8)
  pub let mut fd_dst        : u64 = uninit @align(8)
  pub let mut bytes_copied  : u64 = uninit @align(8)

  // -- Open-flag constants (mirror src/kernel/core/fs/vfs_open.pdx) --
  pub let O_RDONLY_V         : u64 = 0
  pub let O_WRONLY_CREAT_TRUNC : u64 = 0xC1   // O_WRONLY|O_CREAT|O_TRUNC
  pub let DEFAULT_MODE       : u64 = 0x1A4    // 0644 (fallback for tmpfs)

  // POSIX mode field masks. Only S_IFMT + S_IFDIR are needed at v1.1-A;
  // the file-type check is `(mode & S_IFMT) == S_IFDIR`.
  pub let S_IFMT_MASK        : u64 = 0xF000
  pub let S_IFDIR_BITS       : u64 = 0x4000

  // -- Diagnostic strings ---------------------------------------------
  pub let STAT_SRC_FAIL_MSG : [u8; 28] =
    "cp: cannot stat source file\n"
  pub let STAT_SRC_FAIL_MSG_LEN : u64 = 28

  pub let OPEN_SRC_FAIL_MSG : [u8; 28] =
    "cp: cannot open source file\n"
  pub let OPEN_SRC_FAIL_MSG_LEN : u64 = 28

  pub let OPEN_DST_FAIL_MSG : [u8; 33] =
    "cp: cannot open destination file\n"
  pub let OPEN_DST_FAIL_MSG_LEN : u64 = 33

  pub let READ_FAIL_MSG : [u8; 28] =
    "cp: read from source failed\n"
  pub let READ_FAIL_MSG_LEN : u64 = 28

  pub let WRITE_FAIL_MSG : [u8; 32] =
    "cp: write to destination failed\n"
  pub let WRITE_FAIL_MSG_LEN : u64 = 32

  pub let SHORT_WRITE_MSG : [u8; 47] =
    "cp: short write to destination (partial state)\n"
  pub let SHORT_WRITE_MSG_LEN : u64 = 47

  pub let DST_PATH_TOO_LONG_MSG : [u8; 43] =
    "cp: destination path too long (dir + name)\n"
  pub let DST_PATH_TOO_LONG_MSG_LEN : u64 = 43

  // ============================================================================
  // copy_reset()
  //
  // Signature: copy_reset : () -> () !{mem} @{}
  //
  // Zero the three .bss counter slots (fd_src, fd_dst, bytes_copied) so
  // a subsequent copy_bytes_only starts from a known baseline.
  // ============================================================================
  pub let copy_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp v1.1-A copy_reset. Zero the three .bss counter slots (fd_src, fd_dst, bytes_copied) so copy_bytes_only starts from a known baseline. copy_buf is index-consumed (every write is preceded by a read that overwrites it) so trailing bytes do not need zeroing; copy_dst_path is rebuilt from scratch each invocation via copy_join_dir_basename when the directory-DST path fires. r11 is scratch used only for the three leas. Leaf; no push/pop.",
      block: {
        xor rax, rax;
        lea r11, [rip + fd_src];       mov [r11], rax;
        lea r11, [rip + fd_dst];       mov [r11], rax;
        lea r11, [rip + bytes_copied]; mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // copy_join_dir_basename(dst_dir_ptr, src_ptr) -> path_ok
  //
  // Signature: copy_join_dir_basename : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): dst_dir_ptr -- VA of a NUL-terminated directory path
  //                              (the caller has already resolved DST
  //                              to a directory via sys_stat + S_IFDIR)
  // RSI (input): src_ptr     -- VA of a NUL-terminated source path
  // RAX (output): 0 if joined path fits in copy_dst_path (511 usable
  //               bytes + NUL); 1 if it would overflow.
  //
  // Builds copy_dst_path = dst_dir + '/' + basename(src) + '\0' into
  // the module's own .bss slot. On overflow (dir path + basename would
  // exceed 511 bytes) returns 1 without writing a NUL terminator into
  // an ambiguous slot -- the caller propagates a distinct diagnostic.
  //
  // Algorithm:
  //   Phase 1: copy dst_dir bytes into copy_dst_path[0..dir_len).
  //            Cap at 510 to leave room for a possible '/' + at least
  //            one basename byte + NUL. If dst_dir ends with '/'
  //            already, phase 2 skips the added slash.
  //   Phase 2: locate basename(src) -- walk src to its NUL, remember
  //            the index of the last '/' seen (basename_start =
  //            last_slash + 1, or 0 if no slash).
  //   Phase 3: if copy_dst_path[dir_len - 1] != '/', append '/'.
  //   Phase 4: copy src[basename_start..src_nul) into copy_dst_path
  //            until src NUL. Overflow if the combined write would
  //            exceed 511 (leaving room for the trailing NUL).
  //   Phase 5: write NUL, return 0.
  //
  // Leaf. All scratch caller-save (rax/rcx/rdx/r8/r9/r10/r11). No
  // syscall, no callee-save touched, no push/pop parity to preserve.
  // ============================================================================
  pub let copy_join_dir_basename : (u64, u64) -> u64 !{mem} @{} =
    fn (dst_dir_ptr: u64) (src_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp v1.1-A copy_join_dir_basename. Constructs copy_dst_path = dst_dir + '/' + basename(src) + NUL into the module's own .bss when the caller has resolved DST to a directory via sys_stat + S_IFDIR mask. Leaf: uses only caller-save regs (rax=byte scratch, rcx=write cursor, rdx=byte scratch, r8=dst_dir read cursor, r9=src read cursor, r10=basename_start_index, r11=lea scratch for copy_dst_path base). Byte reads via `xor rax,rax; mov_b rax,[reg+reg*1]` per paideia-as compliance (no cmp al,imm8 REX.W ambiguity). Every cmp against a literal uses imm <= 0x7FFFFFFF (largest are 510 and 511, both far below the imm32 cap). No test mnemonic; every zero-check via `cmp reg, 0`. Reserved-label discipline: every internal label prefixed cjb_ (basename `top`/`done`/`loop` are paideia-as keywords). Return: 0 on success (path fits + NUL-terminated); 1 on overflow (caller emits DST_PATH_TOO_LONG_MSG). Overflow guard: dst_dir capped at 510 bytes; combined length checked before each basename write; total path bounded strictly below COPY_DST_PATH_LEN=512 to leave room for the trailing NUL. Slash-idempotency: if dst_dir already ends with '/' the '/' insertion phase is skipped.",
      block: {
        // ---- Phase 1: copy dst_dir into copy_dst_path[0..dir_len) --------
        xor rcx, rcx;                          // rcx = write cursor
        xor r8, r8;                            // r8 = dst_dir read cursor
      cjb_dir_top:
        xor rax, rax;
        mov_b rax, [rdi + r8*1];               // rax = dst_dir[r8]
        cmp rax, 0;
        je cjb_dir_done;                       // NUL end of dst_dir
        cmp rcx, 510;                          // room for '/' + 1 byte + NUL?
        jae cjb_overflow;
        lea r11, [rip + copy_dst_path];
        mov_b [r11 + rcx*1], rax;              // copy_dst_path[rcx] = byte
        add rcx, 1;
        add r8, 1;
        jmp cjb_dir_top;
      cjb_dir_done:
        // rcx = dir_len (0..510). If dir_len == 0 the dst_dir was empty
        // string; treat that as no slash needed (copy_dst_path[0] will
        // be first basename byte).

        // ---- Phase 2: find basename(src) start ---------------------------
        xor r9, r9;                            // r9 = src read cursor
        xor r10, r10;                          // r10 = basename_start (0 default)
      cjb_scan_top:
        xor rax, rax;
        mov_b rax, [rsi + r9*1];
        cmp rax, 0;
        je cjb_scan_done;
        cmp rax, 47;                           // '/'
        jne cjb_scan_next;
        // Saw a slash -- basename_start = r9 + 1.
        mov r10, r9;
        add r10, 1;
      cjb_scan_next:
        add r9, 1;
        cmp r9, 4095;                          // hard cap on src path scan
        jae cjb_scan_done;
        jmp cjb_scan_top;
      cjb_scan_done:
        // r10 = basename_start index within src.

        // ---- Phase 3: append '/' if dst_dir did not end with one ---------
        cmp rcx, 0;
        je cjb_slash_maybe;                    // dir_len == 0 -> no '/' needed
        lea r11, [rip + copy_dst_path];
        xor rax, rax;
        mov rdx, rcx;
        sub rdx, 1;
        mov_b rax, [r11 + rdx*1];              // last dir byte
        cmp rax, 47;
        je cjb_slash_done;                     // already ends with '/'
      cjb_slash_maybe:
        cmp rcx, 511;                          // room for '/' + NUL?
        jae cjb_overflow;
        mov rax, 47;                           // '/'
        lea r11, [rip + copy_dst_path];
        mov_b [r11 + rcx*1], rax;
        add rcx, 1;
      cjb_slash_done:

        // ---- Phase 4: append basename(src) -------------------------------
      cjb_name_top:
        xor rax, rax;
        mov_b rax, [rsi + r10*1];
        cmp rax, 0;
        je cjb_name_done;
        cmp rcx, 511;                          // room for byte + NUL?
        jae cjb_overflow;
        lea r11, [rip + copy_dst_path];
        mov_b [r11 + rcx*1], rax;
        add rcx, 1;
        add r10, 1;
        jmp cjb_name_top;
      cjb_name_done:

        // ---- Phase 5: NUL-terminate + return 0 ---------------------------
        xor rax, rax;
        lea r11, [rip + copy_dst_path];
        mov_b [r11 + rcx*1], rax;
        xor rax, rax;
        ret;

      cjb_overflow:
        mov rax, 1;
        ret
      }
    }

  // ============================================================================
  // copy_bytes_only(src_ptr, dst_ptr) -> exit_code
  //
  // Signature: copy_bytes_only : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): src_ptr -- VA of a NUL-terminated source path
  // RSI (input): dst_ptr -- VA of a NUL-terminated destination path
  // RAX (output): 0 on success; the raw negative-errno u64 from the
  //               failing syscall on failure (bit 63 set).
  //
  // v1.1-A body: real syscalls, no stubs. See the module header for
  // the full flow and the register plan.
  // ============================================================================
  pub let copy_bytes_only : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A copy_bytes_only. Real body: sys_stat(dst)->maybe-basename-join, sys_stat(src)->extract mode, sys_open(src, O_RDONLY, 0), sys_open(effective_dst, 0xC1, src_mode), read/write loop over 4KiB copy_buf until EOF, sys_close(dst) + sys_close(src). Returns 0 on success, or the raw negative-errno u64 from the failing syscall on any failure (caller uses `cmp rax, 0; jl err` per the paideia-os convention). 5-push prologue (rbx=src_ptr then n, r12=dst_ptr, r13=src_mode then free, r14=fd_src, r15=fd_dst) lands rsp%16==0 at every nested call site. Registers cross at least one pdxfs_* call and therefore live in callee-save regs. Error branches close whatever fds are open (0/1/2 fds) and preserve the syscall's raw -errno rax as the returned exit code, printing a one-line stderr diagnostic through Print::print_err. Every cmp reg,imm uses immediate <= 0x7FFFFFFF (0xC1 open flags, 0x4000 S_IFDIR, 4096 buf len). S_IFMT_MASK=0xF000 and DEFAULT_MODE=0x1A4 are also <= 0x7FFFFFFF but staged through r11 for the `and`/comparison consistency. S_IFDIR check uses `cmp rcx, 0x4000` (imm32 fits). DST-not-a-directory (stat fails OR mode & S_IFMT != S_IFDIR) leaves dst_ptr in r12 unchanged. On DST-is-a-dir, copy_join_dir_basename rewrites copy_dst_path and r12 is updated to &copy_dst_path. Src stat mode extracted via `mov_d rax, [statbuf+24]` (u32 mode word zero-extended); mode==0 (tmpfs adapter fills 0) defaults to 0644 to leave sensible perms on a tmpfs target. sysreg effect for the SYSCALL clobber (rcx/r11). All labels prefixed cp_ to avoid `loop`/`done`/`top` keyword collisions.",
      block: {
        // ---- Prologue --------------------------------------------------------
        push rbx;                              // rsp%16: 8 -> 0
        push r12;                              // rsp%16: 0 -> 8
        push r13;                              // rsp%16: 8 -> 0
        push r14;                              // rsp%16: 0 -> 8
        push r15;                              // rsp%16: 8 -> 0

        mov rbx, rdi;                          // rbx = src_ptr
        mov r12, rsi;                          // r12 = dst_ptr

        // ---- Step 0: reset state --------------------------------------------
        call copy_reset;

        // ---- Step 1: stat DST -- is it a directory? -------------------------
        // stat failure (ENOENT, ENOTDIR, ...) is not an error at this
        // stage: it just means DST does not resolve to a directory, so
        // we treat dst_ptr as the literal destination path.
        mov rdi, r12;                          // dst path
        lea rsi, [rip + copy_dst_stat];
        call pdxfs_stat;
        cmp rax, 0;
        jl cp_dst_not_dir;                     // stat failed -> not a dir

        // Extract the mode u32 from the stat buffer at +24 (frozen
        // layout, sys_stat.pdx §Layout). Mask with S_IFMT and check
        // for S_IFDIR bits.
        lea r11, [rip + copy_dst_stat];
        xor rax, rax;
        mov_d rax, [r11 + 24];                 // rax = mode u32 zx
        mov rcx, rax;
        mov r11, 0xF000;                       // S_IFMT (staged via r11)
        and rcx, r11;
        cmp rcx, 0x4000;                       // S_IFDIR bits?
        jne cp_dst_not_dir;                    // no -> use dst_ptr as-is

        // DST is a directory. Build effective dst = DST + '/' +
        // basename(SRC) into copy_dst_path and repoint r12.
        mov rdi, r12;                          // dst_dir_ptr
        mov rsi, rbx;                          // src_ptr
        call copy_join_dir_basename;
        cmp rax, 0;
        jne cp_dst_path_too_long;
        lea r12, [rip + copy_dst_path];        // r12 = effective dst

      cp_dst_not_dir:
        // ---- Step 2: stat SRC -- extract mode -------------------------------
        mov rdi, rbx;                          // src path
        lea rsi, [rip + copy_src_stat];
        call pdxfs_stat;
        cmp rax, 0;
        jl cp_stat_src_fail;

        // r13 = src mode word. tmpfs adapter fills 0 today; fall back
        // to 0644 (0x1A4) so the destination lands at a sensible perm
        // regardless of whether the src backend fills mode meaningfully.
        lea r11, [rip + copy_src_stat];
        xor rax, rax;
        mov_d rax, [r11 + 24];                 // rax = mode u32 zx
        mov r13, rax;
        cmp r13, 0;
        jne cp_mode_ready;
        mov r13, 0x1A4;                        // default 0644

      cp_mode_ready:
        // ---- Step 3: open SRC (O_RDONLY = 0, mode = 0) ---------------------
        mov rdi, rbx;                          // src path
        mov rsi, 0;                            // O_RDONLY
        mov rdx, 0;                            // mode (ignored on read)
        call pdxfs_open;
        cmp rax, 0;
        jl cp_open_src_fail;

        mov r14, rax;                          // r14 = fd_src
        lea r11, [rip + fd_src];
        mov [r11], rax;

        // ---- Step 4: open DST (O_WRONLY|O_CREAT|O_TRUNC = 0xC1, src_mode) --
        mov rdi, r12;                          // effective dst path
        mov rsi, 0xC1;                         // O_WRONLY|O_CREAT|O_TRUNC
        mov rdx, r13;                          // mode from src stat
        call pdxfs_open;
        cmp rax, 0;
        jl cp_open_dst_fail;

        mov r15, rax;                          // r15 = fd_dst
        lea r11, [rip + fd_dst];
        mov [r11], rax;

        // ---- Step 5: read/write loop ---------------------------------------
      cp_loop_head:
        mov rdi, r14;                          // fd_src
        lea rsi, [rip + copy_buf];
        mov rdx, 4096;                         // COPY_BUF_LEN
        call pdxfs_read;

        cmp rax, 0;
        jl cp_read_fail;                       // -errno
        je cp_eof;                             // 0 -> EOF

        mov rbx, rax;                          // rbx = n (bytes read)

        mov rdi, r15;                          // fd_dst
        lea rsi, [rip + copy_buf];
        mov rdx, rbx;                          // len = n
        call pdxfs_write;

        cmp rax, 0;
        jl cp_write_fail;                      // -errno

        cmp rax, rbx;                          // bytes_written < n?
        jl cp_short_write;

        // Accumulate bytes_copied += rax.
        lea r11, [rip + bytes_copied];
        mov rcx, [r11];
        add rcx, rax;
        mov [r11], rcx;

        jmp cp_loop_head;

        // ---- Step 6: success -----------------------------------------------
      cp_eof:
        // Close dst, then src. Return values ignored -- an fd release
        // error is not something the caller can act on and the fd is
        // released at task teardown regardless.
        mov rdi, r15;
        call pdxfs_close;

        mov rdi, r14;
        call pdxfs_close;

        xor rax, rax;                          // EXIT_OK (0)
        jmp cp_epilogue;

        // ---- Error branches -------------------------------------------------
        // Every error branch preserves the failing syscall's -errno in
        // rax (by staging it to rbx across the diagnostic + close
        // calls) and returns that verbatim per v1.1-A's "-errno on
        // failure" contract.
      cp_dst_path_too_long:
        // No fds open, no stats matter. The overflow return from
        // copy_join_dir_basename was 1 (positive), which is not a
        // valid -errno; synthesize -ENAMETOOLONG (36) as the return
        // sentinel so the caller's `jl err` gate fires.
        mov rbx, 0xFFFFFFFFFFFFFFDC;           // -36 == -ENAMETOOLONG
        lea rdi, [rip + DST_PATH_TOO_LONG_MSG];
        mov rsi, 43;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_stat_src_fail:
        // stat failed. rax has the -errno; save across print_err.
        mov rbx, rax;
        lea rdi, [rip + STAT_SRC_FAIL_MSG];
        mov rsi, 28;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_open_src_fail:
        mov rbx, rax;
        lea rdi, [rip + OPEN_SRC_FAIL_MSG];
        mov rsi, 28;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_open_dst_fail:
        // fd_src is open; close it before we return.
        mov rbx, rax;                          // save -errno
        mov rdi, r14;
        call pdxfs_close;                      // ignore return

        lea rdi, [rip + OPEN_DST_FAIL_MSG];
        mov rsi, 33;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_read_fail:
        mov rbx, rax;
        mov rdi, r15;
        call pdxfs_close;
        mov rdi, r14;
        call pdxfs_close;

        lea rdi, [rip + READ_FAIL_MSG];
        mov rsi, 28;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_write_fail:
        mov rbx, rax;
        mov rdi, r15;
        call pdxfs_close;
        mov rdi, r14;
        call pdxfs_close;

        lea rdi, [rip + WRITE_FAIL_MSG];
        mov rsi, 32;
        call print_err;
        mov rax, rbx;
        jmp cp_epilogue;

      cp_short_write:
        // Short write: no distinct errno, use -EIO (-5) as the sentinel
        // so callers' `jl err` gate fires. Close both fds.
        mov rdi, r15;
        call pdxfs_close;
        mov rdi, r14;
        call pdxfs_close;

        lea rdi, [rip + SHORT_WRITE_MSG];
        mov rsi, 47;
        call print_err;
        mov rax, 0xFFFFFFFFFFFFFFFB;           // -5 == -EIO
        jmp cp_epilogue;

        // ---- Shared epilogue ------------------------------------------------
      cp_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // copy_single_file(src_ptr, dst_ptr) -> exit_code
  //
  // Signature: copy_single_file : (u64, u64) -> u64 !{mem, sysreg} @{}
  //
  // Backward-compatible entry-point name preserved for the test-target
  // vocabulary and doc references. Thin forwarder to copy_bytes_only.
  // ============================================================================
  pub let copy_single_file : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A copy_single_file forwarder. Preserves the M1-vintage entry-point name for test-target continuity. 1-push prologue (rbx for rsp alignment; unused body-side). Same signature + semantics as copy_bytes_only; the M2-004 outer-TXN wrap that used to matter for this alias is retired with the M1-001 STUB shape in v1.1-A.",
      block: {
        push rbx;                              // align rsp for nested call

        call copy_bytes_only;
        // rax carries copy_bytes_only's exit code (0 or -errno).

        pop rbx;
        ret
      }
    }
}
