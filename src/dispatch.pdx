// src/dispatch.pdx — cp.M1-002 (bodies) + cp.M1-003 (happy-arm wire)
//                    + cp.M2-001 (typed flags + recursive route)
// Dispatch module: flag gate + positional-count validate + route.
//
// Scope
// -----
// The M2 argv surface accepts four cp-specific flags (`-r`, `-v`,
// `--dry-run`, `--over-existing`) and two required positionals (src,
// dst). This module populates CpFlags::* mirror slots from libpdx-argv's
// typed-flag storage (populated by Parser::parse_argv after FlagSpec
// registration in main), then picks one of three exits:
//
//   1. CpFlags::flag_recursive_seen != 0 → Walk::walk_recursive(src, dst);
//      its exit code is our exit code. (M1 exited 3 with a "not yet
//      implemented" diagnostic here; M2 lands the real recursive path
//      via the Walk module.)
//   2. pos_count != 2 → USAGE_MSG on stderr; EXIT 2.
//   3. otherwise → CopyFile::copy_single_file(pos_ptrs[0], pos_ptrs[1]);
//      its exit code is our exit code.
//
// The M1 byte-compare flag walk (`for i in flag_names[]: mov_b rax,
// [flag_names[i]]; cmp rax, 'r'`) is replaced at M2 by a single
// CpFlags::populate call that reads the four ID mirrors from
// ParsedArgs via find_flag_by_id. The verbose short/long fold-in is
// handled inside CpFlags::populate; dispatch reads only the mirror.
//
// Cross-module externs consumed
// -----------------------------
//   ParsedArgs::pos_count        (libpdx-argv .bss)
//   ParsedArgs::pos_ptrs         (libpdx-argv .bss, [u64;32])
//   CpFlags::populate            (this repo, src/flags.pdx)
//   CpFlags::flags_reset         (this repo, src/flags.pdx)
//   CpFlags::flag_recursive_seen (this repo, src/flags.pdx)
//   CopyFile::copy_single_file   (this repo, src/copy.pdx)
//   Walk::walk_recursive         (this repo, src/walk.pdx)
//   Print::print_err             (this repo, src/print.pdx)
//
// paideia-as compliance
// ---------------------
//   - Module Dispatch (PascalCase basename).
//   - No test mnemonic; every zero-check uses cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (all values used here fit).
//   - r11 is scratch (every lea for .bss / .rodata bases).
//   - Byte loads not needed at M2 (removed with the byte-compare walk).
//   - 1-push prologue (rbx) aligns rsp%16 to 0 for the nested calls.

module Dispatch = structure {

  // -- Exit codes --------------------------------------------------------
  // See design/argv-surface.md §5 for the full contract. Codes 3 and 4
  // are deliberately reserved so a script can distinguish
  // "vocabulary-recognised-but-not-wired" (3) from "cap-denied" (4)
  // from generic "op-failed" (1). At M2, code 3 is unused on the
  // happy-flow path — the recursive arm calls Walk::walk_recursive
  // whose 0/1 return propagates directly. Code 3 remains reserved for
  // future M3+ "recognized flag, not-yet-wired" arms (e.g. --json
  // when semantic-pipe isn't in-tree).
  pub let EXIT_OK                : u64 = 0
  pub let EXIT_OP_FAIL           : u64 = 1
  pub let EXIT_USAGE             : u64 = 2
  pub let EXIT_NOT_YET_IMPL      : u64 = 3
  pub let EXIT_CAP_DENIED        : u64 = 4

  // -- Diagnostic strings emitted on the reject paths -------------------
  //
  // USAGE_MSG covers every wrong-positional case at M2 (zero args, one
  // arg, three-or-more args). A future M3+ can distinguish these once
  // a directory-target `cp <src>... <dir>` shape lands, at which point
  // "three-or-more" becomes valid.
  pub let USAGE_MSG : [u8; 60] =
    "cp: usage error (expected exactly two positional arguments)\n"
  pub let USAGE_MSG_LEN : u64 = 60

  // Retained from M1 for symmetry / diagnostic testability; unreachable
  // on the M2 happy-flow path. Kept because a future gating change
  // (e.g. --no-recurse suppress) may re-enter this arm.
  pub let RECURSIVE_NOT_YET_MSG : [u8; 64] =
    "cp: recursive copy (-r) not yet implemented at M1 (lands at M2)\n"
  pub let RECURSIVE_NOT_YET_MSG_LEN : u64 = 64

  // M1-era stub message. Kept for grep-ability across the M1→M2
  // transition; no M2 code path emits it.
  pub let COPY_STUB_MSG : [u8; 58] =
    "cp: copy body not implemented at M1-002 (lands at M1-003)\n"
  pub let COPY_STUB_MSG_LEN : u64 = 58

  // -- Dispatch state ---------------------------------------------------
  // Records which arm fired; useful at M3 for the audit-first journal
  // record that has to name the operation before any output.
  // Values: 0 = none, 1 = single-file copy, 2 = usage, 3 = recursive-nyi
  //         (M2 no longer sets 3 on the happy path), 4 = recursive walk.
  pub let mut chosen_arm : u64 = uninit @align(8)

  // -- Arm identifiers --------------------------------------------------
  pub let ARM_NONE            : u64 = 0
  pub let ARM_SINGLE_FILE     : u64 = 1
  pub let ARM_USAGE           : u64 = 2
  pub let ARM_RECURSIVE_NYI   : u64 = 3       // M1 legacy; not set at M2
  pub let ARM_RECURSIVE_WALK  : u64 = 4       // NEW at M2

  // ============================================================================
  // dispatch_reset()
  //
  // Signature: dispatch_reset : () -> () !{mem} @{}
  //
  // Clear chosen_arm so a subsequent dispatch_copy call starts from a
  // known-zero baseline. Called by cp_main before it hands control to
  // dispatch_copy.
  // ============================================================================
  pub let dispatch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp.M1-002 dispatch_reset. Zero chosen_arm so dispatch_copy starts from a known baseline. Leaf; r11 scratch used only for the lea.",
      block: {
        xor rax, rax;
        lea r11, [rip + chosen_arm];
        mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // dispatch_copy() -> exit_code
  //
  // Signature: dispatch_copy : () -> u64 !{mem, sysreg} @{}
  // RAX (output): exit code (0..4)
  //
  // Flow (M2):
  //   Step 1: CpFlags::flags_reset + CpFlags::populate — mirror the
  //           four cp flag IDs into the CpFlags .bss slots.
  //   Step 2: check pos_count == 2. If not, jump to USAGE arm.
  //   Step 3: check CpFlags::flag_recursive_seen. If set, load
  //           pos_ptrs[0]/pos_ptrs[1] into rdi/rsi and call
  //           Walk::walk_recursive; adopt its return as our exit code.
  //   Step 4: otherwise (single-file path), load pos_ptrs[0]/pos_ptrs[1]
  //           into rdi/rsi and call CopyFile::copy_single_file; adopt
  //           its return as our exit code.
  //
  // Prologue: 1 push (rbx). rsp%16 was 8 on entry (SysV call), one
  // push brings it to 0 for the nested Print::print_err /
  // CopyFile::copy_single_file / Walk::walk_recursive calls. rbx unused
  // body-side at M2 but preserved for the M3+ shape that will hold the
  // outer TXN handle across the copy dispatch (per cp.M2-004's TXN
  // wrap at dispatch level).
  //
  // Register plan (M2):
  //   rbx = unused; preserved for M2-004's TXN-handle shape
  //   rax = call return / temp
  //   rdi, rsi = nested-call arg carriers
  //   r11 = lea scratch (every .bss / .rodata address)
  // ============================================================================
  pub let dispatch_copy : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp.M1-002 dispatch_copy body + cp.M1-003 happy-arm wire + cp.M2-001 typed flags + recursive route. Migrates from M1's byte-compare walk over ParsedArgs::flag_names to M2's mirror-driven check via CpFlags::flag_recursive_seen. Flow: CpFlags::flags_reset → CpFlags::populate → check pos_count == 2 → check flag_recursive_seen → route to Walk::walk_recursive (recursive) or CopyFile::copy_single_file (single). 1-push prologue (rbx) aligns rsp%16 to 0 for every nested call. rbx unused body-side; reserved for M2-004's TXN-handle shape that will wrap this dispatch under a single per-invocation transaction. Every fail arm structure is print+pop+exit-code+ret so rax carries the exit code out cleanly; every happy arm is pos_ptrs-load+call+pop+ret so the copy/walk exit code passes through untouched. Every cmp reg,imm uses immediate ≤ 0x7FFFFFFF (largest: 2 for pos_count, 4 for ARM_RECURSIVE_WALK).",
      block: {
        push rbx;

        // ---- Step 1: mirror the four cp flag IDs ---------------------------
        call CpFlags::flags_reset;
        call CpFlags::populate;

        // ---- Step 2: pos_count == 2 check ----------------------------------
        lea r11, [rip + ParsedArgs::pos_count];
        mov rax, [r11];
        cmp rax, 2;
        jne dispatch_usage_error;

        // ---- Step 3: recursive flag check ----------------------------------
        lea r11, [rip + CpFlags::flag_recursive_seen];
        mov rax, [r11];
        cmp rax, 0;
        je dispatch_single_file;

        // Recursive arm: walk_recursive(pos_ptrs[0], pos_ptrs[1]).
        mov rax, 4;                            // ARM_RECURSIVE_WALK
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea r11, [rip + ParsedArgs::pos_ptrs];
        mov rdi, [r11 + 0];                    // src = pos_ptrs[0]
        mov rsi, [r11 + 8];                    // dst = pos_ptrs[1]
        call Walk::walk_recursive;
        // rax now carries Walk::walk_recursive's exit code (0 or 1).

        pop rbx;
        ret

        // ---- Step 4: single-file arm ---------------------------------------
      dispatch_single_file:
        mov rax, 1;                            // ARM_SINGLE_FILE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea r11, [rip + ParsedArgs::pos_ptrs];
        mov rdi, [r11 + 0];                    // src = pos_ptrs[0]
        mov rsi, [r11 + 8];                    // dst = pos_ptrs[1]
        call CopyFile::copy_single_file;
        // rax now carries CopyFile's exit code (0 or 1).

        pop rbx;
        ret

      dispatch_usage_error:
        mov rax, 2;                            // ARM_USAGE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea rdi, [rip + USAGE_MSG];
        mov rsi, 60;                           // USAGE_MSG_LEN
        call Print::print_err;

        pop rbx;
        mov rax, 2;                            // EXIT_USAGE
        ret
      }
    }
}
