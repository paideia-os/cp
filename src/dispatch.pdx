// src/dispatch.pdx -- cp v1.1-A (real-body dispatch)
// Dispatch module: positional-count validate + route to copy body.
//
// Scope (v1.1-A)
// --------------
// v1.0's dispatch wrapped the whole invocation in a KIND_PDXFS_TXN
// begin/commit/abort trio (stubbed against a substrate that never
// landed), a libpdx-audit begin/commit wrap, a CpFlags typed-flag
// populate + mirror lookup, a --dry-run short-circuit, a
// paths-conflict pre-TXN gate, and a recursive-vs-single-file route
// into Walk::walk_recursive or CopyFile::copy_bytes_only. Retiring
// the M1-001 STUB shape at v1.1-A collapses all of that to a
// three-line body:
//
//   1. Reject anything other than exactly two positional arguments
//      (usage error -> stderr diagnostic + EXIT_USAGE = 2).
//   2. Call CopyFile::copy_bytes_only(pos_ptrs[0], pos_ptrs[1]).
//   3. Return the copy body's exit code verbatim (0 on success or the
//      raw negative-errno u64 from the failing syscall).
//
// -r/-p/-i/--over-existing/--dry-run/--verbose are out of scope at
// v1.1-A; the parser still recognises them via libpdx-argv's
// StdVocab (--verbose, --dry-run, --help, --version) but no arm here
// consumes them. A v1.2 landing re-introduces -p (perm preserve
// beyond src's mode word); v1.3+ decides on -r once the walker sits
// on a real, non-stub sys_getdents contract.
//
// Cross-module externs consumed
// -----------------------------
//   ParsedArgs::pos_count      (libpdx-argv .bss)
//   ParsedArgs::pos_ptrs       (libpdx-argv .bss, [u64;32])
//   CopyFile::copy_bytes_only  (this repo, src/copy.pdx)
//   Print::print_err           (this repo, src/print.pdx)
//
// paideia-as compliance (v0.36+)
// ------------------------------
//   - Module Dispatch (PascalCase basename matches src/dispatch.pdx).
//   - No test mnemonic; every zero-check via `cmp reg, 0`.
//   - Every cmp reg,imm uses immediate <= 0x7FFFFFFF.
//   - r11 is scratch (every lea for .bss / .rodata bases).
//   - 1-push prologue (rbx unused body-side; pushed to align rsp%16
//     to 0 for the two nested calls at most: print_err on the usage
//     arm, copy_bytes_only on the happy arm).

module Dispatch = structure {

  // -- Exit codes -------------------------------------------------------
  // v1.1-A collapses the v1.0 exit code table:
  //   0 (EXIT_OK) on copy success.
  //   2 (EXIT_USAGE) on wrong positional count -- stable script
  //     contract, unchanged from v1.0.
  //   Any negative-errno u64 (bit 63 set) from copy_bytes_only when
  //     a syscall inside the copy body fails.
  // v1.0's EXIT_OP_FAIL (1), EXIT_NOT_YET_IMPL (3), EXIT_CAP_DENIED
  // (4) all retire with the M1-001 STUB shape -- there is no arm in
  // v1.1-A that would return them.
  pub let EXIT_OK    : u64 = 0
  pub let EXIT_USAGE : u64 = 2

  // -- Diagnostic strings emitted on the reject paths -------------------
  pub let USAGE_MSG : [u8; 60] =
    "cp: usage error (expected exactly two positional arguments)\n"
  pub let USAGE_MSG_LEN : u64 = 60

  // -- Dispatch state ---------------------------------------------------
  // Records which arm fired -- retained from v1.0 for potential future
  // audit journal correlation but not consumed at v1.1-A. Values:
  //   0 = none, 1 = single-file copy, 2 = usage.
  pub let mut chosen_arm : u64 = uninit @align(8)

  pub let ARM_NONE        : u64 = 0
  pub let ARM_SINGLE_FILE : u64 = 1
  pub let ARM_USAGE       : u64 = 2

  // ============================================================================
  // dispatch_reset()
  //
  // Signature: dispatch_reset : () -> () !{mem} @{}
  //
  // Clear chosen_arm so a subsequent dispatch_copy call starts from a
  // known-zero baseline.
  // ============================================================================
  pub let dispatch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp v1.1-A dispatch_reset. Zero chosen_arm so dispatch_copy starts from a known baseline. Leaf; r11 scratch used only for the lea.",
      block: {
        xor rax, rax;
        lea r11, [rip + chosen_arm];
        mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // dispatch_copy() -> exit_code
  //
  // Signature: dispatch_copy : () -> u64 !{mem, sysreg} @{}
  // RAX (output): 0 on success; 2 on usage error; negative-errno u64
  //               on copy failure.
  //
  // Flow (v1.1-A):
  //   Step 1: check pos_count == 2. If not, print USAGE_MSG and
  //           return EXIT_USAGE.
  //   Step 2: call CopyFile::copy_bytes_only(pos_ptrs[0], pos_ptrs[1]).
  //           Its return is our return.
  //
  // Register plan (1-push prologue -> rsp%16 == 0 at every nested call):
  //   rbx = pushed for alignment; not read body-side.
  //   rax = call return / temp.
  //   rdi, rsi = nested-call arg carriers.
  //   r11 = lea scratch.
  // ============================================================================
  pub let dispatch_copy : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A dispatch_copy. Collapses the v1.0 audit-wrap + TXN-wrap + flags-populate + dry-run + paths-conflict + recursive-route dispatch shell to a two-step body: pos_count==2 gate then copy_bytes_only call. 1-push prologue (rbx unused body-side; pushed to align rsp%16 to 0 for the nested print_err/copy_bytes_only calls). Return semantics: EXIT_OK (0) on copy success, EXIT_USAGE (2) on wrong positional count, or the raw negative-errno u64 from the failing syscall inside copy_bytes_only (bit 63 set) -- the caller uses `cmp rax, 0; jl err` to detect failure per the paideia-os convention. Every cmp reg,imm uses imm <= 0x7FFFFFFF (largest is 2 for pos_count). chosen_arm is stamped for potential future audit correlation but no arm reads it at v1.1-A. Recursive route, TXN abort/commit, audit begin/commit, and the flags-populate call all retire with the M1-001 STUB shape.",
      block: {
        // ---- Prologue -------------------------------------------------------
        push rbx;                              // rsp%16: 8 -> 0

        // ---- Step 1: pos_count == 2 check ----------------------------------
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 2;
        jne dispatch_usage_error;

        // ---- Step 2: copy_bytes_only(pos_ptrs[0], pos_ptrs[1]) -------------
        mov rax, 1;                            // ARM_SINGLE_FILE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + 0];                    // src = pos_ptrs[0]
        mov rsi, [r11 + 8];                    // dst = pos_ptrs[1]
        call copy_bytes_only;
        // rax carries copy_bytes_only's exit code (0 or -errno);
        // fall through to the epilogue.
        jmp dispatch_epilogue;

      dispatch_usage_error:
        mov rax, 2;                            // ARM_USAGE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea rdi, [rip + USAGE_MSG];
        mov rsi, 60;                           // USAGE_MSG_LEN
        call print_err;

        mov rax, 2;                            // EXIT_USAGE
        jmp dispatch_epilogue;

      dispatch_epilogue:
        pop rbx;
        ret
      }
    }
}
