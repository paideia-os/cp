// src/dispatch.pdx — cp.M1-002 (bodies) + cp.M1-003 (happy-arm wire)
//                    + cp.M2-001 (typed flags + recursive route)
//                    + cp.M2-004 (single-TXN hoist across whole invocation)
//                    + cp.M3-002 (audit begin/commit wrap around dispatch)
// Dispatch module: flag gate + positional-count validate + route +
// outer KIND_PDXFS_TXN wrap.
//
// Scope
// -----
// The M2 argv surface accepts four cp-specific flags (`-r`, `-v`,
// `--dry-run`, `--over-existing`) and two required positionals (src,
// dst). This module populates CpFlags::* mirror slots from libpdx-argv's
// typed-flag storage (populated by Parser::parse_argv after FlagSpec
// registration in main), then picks one of three exits:
//
//   1. CpFlags::flag_recursive_seen != 0 → Walk::walk_recursive(src, dst);
//      its exit code is our exit code. (M1 exited 3 with a "not yet
//      implemented" diagnostic here; M2 lands the real recursive path
//      via the Walk module.)
//   2. pos_count != 2 → USAGE_MSG on stderr; EXIT 2.
//   3. otherwise → CopyFile::copy_single_file(pos_ptrs[0], pos_ptrs[1]);
//      its exit code is our exit code.
//
// The M1 byte-compare flag walk (`for i in flag_names[]: mov_b rax,
// [flag_names[i]]; cmp rax, 'r'`) is replaced at M2 by a single
// CpFlags::populate call that reads the four ID mirrors from
// ParsedArgs via find_flag_by_id. The verbose short/long fold-in is
// handled inside CpFlags::populate; dispatch reads only the mirror.
//
// Cross-module externs consumed
// -----------------------------
//   ParsedArgs::pos_count        (libpdx-argv .bss)
//   ParsedArgs::pos_ptrs         (libpdx-argv .bss, [u64;32])
//   CpFlags::populate            (this repo, src/flags.pdx)
//   CpFlags::flags_reset         (this repo, src/flags.pdx)
//   CpFlags::flag_recursive_seen (this repo, src/flags.pdx)
//   CopyFile::copy_bytes_only    (this repo, src/copy.pdx)  [M2-004: was copy_single_file]
//   Walk::walk_recursive         (this repo, src/walk.pdx)
//   Pdxfs::pdxfs_txn_begin       (this repo, src/pdxfs.pdx) [M2-004: TXN wrap]
//   Pdxfs::pdxfs_txn_commit      (this repo, src/pdxfs.pdx) [M2-004: TXN wrap]
//   Pdxfs::pdxfs_txn_abort       (this repo, src/pdxfs.pdx) [M2-004: partial rollback]
//   Print::print_err             (this repo, src/print.pdx)
//   CpAudit::cp_audit_begin_wrap  (this repo, src/audit.pdx) [M3-002]
//   CpAudit::cp_audit_commit_wrap (this repo, src/audit.pdx) [M3-002]
//
// paideia-as compliance
// ---------------------
//   - Module Dispatch (PascalCase basename).
//   - No test mnemonic; every zero-check uses cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (all values used here fit).
//   - r11 is scratch (every lea for .bss / .rodata bases).
//   - Byte loads not needed at M2 (removed with the byte-compare walk).
//   - 1-push prologue (rbx) aligns rsp%16 to 0 for the nested calls.

module Dispatch = structure {

  // -- Exit codes --------------------------------------------------------
  // See design/argv-surface.md §5 for the full contract. Codes 3 and 4
  // are deliberately reserved so a script can distinguish
  // "vocabulary-recognised-but-not-wired" (3) from "cap-denied" (4)
  // from generic "op-failed" (1). At M2, code 3 is unused on the
  // happy-flow path — the recursive arm calls Walk::walk_recursive
  // whose 0/1 return propagates directly. Code 3 remains reserved for
  // future M3+ "recognized flag, not-yet-wired" arms (e.g. --json
  // when semantic-pipe isn't in-tree).
  pub let EXIT_OK                : u64 = 0
  pub let EXIT_OP_FAIL           : u64 = 1
  pub let EXIT_USAGE             : u64 = 2
  pub let EXIT_NOT_YET_IMPL      : u64 = 3
  pub let EXIT_CAP_DENIED        : u64 = 4

  // -- Diagnostic strings emitted on the reject paths -------------------
  //
  // USAGE_MSG covers every wrong-positional case at M2 (zero args, one
  // arg, three-or-more args). A future M3+ can distinguish these once
  // a directory-target `cp <src>... <dir>` shape lands, at which point
  // "three-or-more" becomes valid.
  pub let USAGE_MSG : [u8; 60] =
    "cp: usage error (expected exactly two positional arguments)\n"
  pub let USAGE_MSG_LEN : u64 = 60

  // Retained from M1 for symmetry / diagnostic testability; unreachable
  // on the M2 happy-flow path. Kept because a future gating change
  // (e.g. --no-recurse suppress) may re-enter this arm.
  pub let RECURSIVE_NOT_YET_MSG : [u8; 64] =
    "cp: recursive copy (-r) not yet implemented at M1 (lands at M2)\n"
  pub let RECURSIVE_NOT_YET_MSG_LEN : u64 = 64

  // M1-era stub message. Kept for grep-ability across the M1→M2
  // transition; no M2 code path emits it.
  pub let COPY_STUB_MSG : [u8; 58] =
    "cp: copy body not implemented at M1-002 (lands at M1-003)\n"
  pub let COPY_STUB_MSG_LEN : u64 = 58

  // -- TXN failure diagnostics (M2-004) ---------------------------------
  //
  // Migrated from CopyFile at M2-004 when the KIND_PDXFS_TXN wrap
  // hoisted from copy_single_file to this dispatch level. Emitted on
  // outer-TXN failure — cp exits with EXIT_OP_FAIL (1) when either
  // begin or commit fails. The abort call on body-failure is silent;
  // its return is ignored because there is no useful action cp can
  // take if abort itself fails.
  pub let TXN_BEGIN_FAIL_MSG : [u8; 29] =
    "cp: transaction begin failed\n"
  pub let TXN_BEGIN_FAIL_MSG_LEN : u64 = 29

  pub let TXN_COMMIT_FAIL_MSG : [u8; 30] =
    "cp: transaction commit failed\n"
  pub let TXN_COMMIT_FAIL_MSG_LEN : u64 = 30

  // -- Dispatch state ---------------------------------------------------
  // Records which arm fired; useful at M3 for the audit-first journal
  // record that has to name the operation before any output.
  // Values: 0 = none, 1 = single-file copy, 2 = usage, 3 = recursive-nyi
  //         (M2 no longer sets 3 on the happy path), 4 = recursive walk.
  pub let mut chosen_arm : u64 = uninit @align(8)

  // -- Arm identifiers --------------------------------------------------
  pub let ARM_NONE            : u64 = 0
  pub let ARM_SINGLE_FILE     : u64 = 1
  pub let ARM_USAGE           : u64 = 2
  pub let ARM_RECURSIVE_NYI   : u64 = 3       // M1 legacy; not set at M2
  pub let ARM_RECURSIVE_WALK  : u64 = 4       // NEW at M2

  // ============================================================================
  // dispatch_reset()
  //
  // Signature: dispatch_reset : () -> () !{mem} @{}
  //
  // Clear chosen_arm so a subsequent dispatch_copy call starts from a
  // known-zero baseline. Called by cp_main before it hands control to
  // dispatch_copy.
  // ============================================================================
  pub let dispatch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cp.M1-002 dispatch_reset. Zero chosen_arm so dispatch_copy starts from a known baseline. Leaf; r11 scratch used only for the lea.",
      block: {
        xor rax, rax;
        lea r11, [rip + chosen_arm];
        mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // dispatch_copy() -> exit_code
  //
  // Signature: dispatch_copy : () -> u64 !{mem, sysreg} @{}
  // RAX (output): exit code (0..4)
  //
  // Flow (M2 including M2-004 TXN hoist):
  //   Step 1: CpFlags::flags_reset + CpFlags::populate — mirror the
  //           four cp flag IDs into the CpFlags .bss slots.
  //   Step 2: check pos_count == 2. If not, jump to USAGE arm (no TXN
  //           opened; usage error is a pre-TXN condition).
  //   Step 3: pdxfs_txn_begin — open the outer per-invocation TXN.
  //           On failure jump to TXN-begin-fail arm.
  //   Step 4: check CpFlags::flag_recursive_seen. Route to
  //           Walk::walk_recursive (recursive) or CopyFile::copy_bytes_only
  //           (single-file). Both run inside the outer TXN. Save the
  //           body's exit code in rbx.
  //   Step 5: if body-exit != 0, pdxfs_txn_abort (silent) and return
  //           the body's exit code. Otherwise pdxfs_txn_commit; on
  //           commit-fail print + return 1; on commit success return 0.
  //
  // Register plan (2-push prologue → rsp%16 == 0 at every nested call):
  //   rbx = body exit code (survives txn_commit / txn_abort call)
  //   r12 = pushed for parity + reserved for M3's audit_id handle
  //   rax = call return / temp
  //   rdi, rsi = nested-call arg carriers
  //   r11 = lea scratch (every .bss / .rodata address)
  //
  // rsp arithmetic:
  //   caller-of-dispatch_copy: rsp%16 == 0 immediately before call
  //   after CALL:              rsp%16 == 8
  //   after push rbx:          rsp%16 == 0
  //   after push r12:          rsp%16 == 8
  //   after sub rsp, 8:        rsp%16 == 0  ← every nested call ok
  //   epilogue reverses.
  // ============================================================================
  pub let dispatch_copy : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp.M2-001 typed flags + cp.M2-004 single-TXN hoist + cp.M3-002 audit wrap. Migrates the M1 byte-compare walk to CpFlags mirror check, hoists the KIND_PDXFS_TXN wrap from copy_single_file to dispatch level so a SINGLE outer TXN spans the whole invocation, and wraps the entire dispatch in a libpdx-audit begin/commit pair so the supervisor sees UEJ_KIND_TOOL_INVOKE at entry and UEJ_KIND_TOOL_EXIT at exit — per plan §5.6 M2/M3 lines. D3 (audit-first) ordering: cp_audit_begin_wrap fires BEFORE the pos_count gate (which itself could emit USAGE_MSG on stderr); begin therefore lands before any user-visible output. Flow: audit_begin_wrap → reset+populate CpFlags → pos_count gate (usage-error exits pre-TXN, audit_commit_wrap still fires at epilogue with exit_code=2) → pdxfs_txn_begin → route to Walk::walk_recursive or CopyFile::copy_bytes_only (body exit saved in rbx) → on body fail call pdxfs_txn_abort (silent, unwind partial writes) and return body exit → on body ok call pdxfs_txn_commit → return 0 on commit-ok, 1 with diagnostic on commit-fail. Every exit path routes through dispatch_epilogue which does the M3-002 audit_commit_wrap(exit_code=rax) call BEFORE the stack cleanup — the exit code is saved in rbx across the commit call (which is caller-save-clobbering) and restored to rax before ret. 2-push prologue (rbx=body_exit/save-across-commit, r12=reserved for M3 audit_id echo) + `sub rsp, 8` pad keeps rsp%16 == 0 at every nested call site (9 call sites: audit_begin_wrap, flags_reset, populate, print_err, txn_begin, walk_recursive/copy_bytes_only, txn_abort, txn_commit, audit_commit_wrap). Every cmp reg,imm uses immediate ≤ 0x7FFFFFFF (largest: 2 for pos_count, 4 for ARM_RECURSIVE_WALK). Negative-errno detection on TXN returns uses cmp rax,0; jl (signed compare).",
      block: {
        // ---- Prologue -------------------------------------------------------
        push rbx;                              // rsp%16: 8 → 0
        push r12;                              // rsp%16: 0 → 8
        sub rsp, 8;                            // rsp%16: 8 → 0

        // ---- Step 0 (M3-002): audit begin ----------------------------------
        // MUST fire before any user-visible output (D3 audit-first).
        // The pos_count gate below may emit USAGE_MSG on stderr, so
        // begin lands here at the top. cp_audit_begin_wrap's return
        // (audit_id or 0) is stored inside CpAudit's .bss slot; we
        // do not gate on it at M3 (broker unavailable is a shape-in-
        // place condition today; M4 hardens with audit_can_emit_output).
        call cp_audit_begin_wrap;

        // ---- Step 1: mirror the four cp flag IDs ---------------------------
        call flags_reset;
        call populate;

        // ---- Step 2: pos_count == 2 check (pre-TXN) ------------------------
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 2;
        jne dispatch_usage_error;

        // ---- Step 3: open outer TXN ----------------------------------------
        call pdxfs_txn_begin;
        cmp rax, 0;
        jl dispatch_txn_begin_fail;

        // ---- Step 4: recursive-vs-single route (both under the TXN) --------
        lea r11, [rip + flag_recursive_seen];
        mov rax, [r11];
        cmp rax, 0;
        je dispatch_single_file;

        // Recursive arm.
        mov rax, 4;                            // ARM_RECURSIVE_WALK
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + 0];                    // src = pos_ptrs[0]
        mov rsi, [r11 + 8];                    // dst = pos_ptrs[1]
        call walk_recursive;
        mov rbx, rax;                          // rbx = body exit code
        jmp dispatch_body_return;

      dispatch_single_file:
        mov rax, 1;                            // ARM_SINGLE_FILE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + 0];                    // src = pos_ptrs[0]
        mov rsi, [r11 + 8];                    // dst = pos_ptrs[1]
        call copy_bytes_only;
        mov rbx, rax;                          // rbx = body exit code

        // ---- Step 5: commit or abort based on body exit --------------------
      dispatch_body_return:
        cmp rbx, 0;
        jne dispatch_body_fail_abort;

        // Body succeeded — commit the TXN.
        call pdxfs_txn_commit;
        cmp rax, 0;
        jl dispatch_txn_commit_fail;

        // Success. rbx still 0.
        mov rax, rbx;                          // rax = 0
        jmp dispatch_epilogue;

      dispatch_body_fail_abort:
        // Body failed. Abort the TXN (silent; return ignored) and
        // propagate the body's exit code as our exit code.
        call pdxfs_txn_abort;
        mov rax, rbx;                          // preserve body exit
        jmp dispatch_epilogue;

      dispatch_txn_begin_fail:
        lea rdi, [rip + TXN_BEGIN_FAIL_MSG];
        mov rsi, 29;                           // TXN_BEGIN_FAIL_MSG_LEN
        call print_err;
        mov rax, 1;                            // EXIT_OP_FAIL
        jmp dispatch_epilogue;

      dispatch_txn_commit_fail:
        // Commit failed. Best-effort abort (silent) and return 1.
        call pdxfs_txn_abort;
        lea rdi, [rip + TXN_COMMIT_FAIL_MSG];
        mov rsi, 30;                           // TXN_COMMIT_FAIL_MSG_LEN
        call print_err;
        mov rax, 1;                            // EXIT_OP_FAIL
        jmp dispatch_epilogue;

      dispatch_usage_error:
        mov rax, 2;                            // ARM_USAGE
        lea r11, [rip + chosen_arm];
        mov [r11], rax;

        lea rdi, [rip + USAGE_MSG];
        mov rsi, 60;                           // USAGE_MSG_LEN
        call print_err;

        mov rax, 2;                            // EXIT_USAGE
        jmp dispatch_epilogue;

      dispatch_epilogue:
        // ---- Step 6 (M3-002): audit commit -------------------------------
        // Every path lands here with rax == the exit code that will be
        // returned to the caller. cp_audit_commit_wrap(exit_code) fires
        // UEJ_KIND_TOOL_EXIT with the correct exit code. The commit-wrap
        // call is caller-save-clobbering (rax at minimum), so we save
        // the exit code in rbx (already pushed at prologue; will be
        // popped below) and restore rax = rbx after the call. The
        // commit-wrap return value (AUDIT_OK or non-zero) is discarded —
        // audit-broker-unavailable at M3 does not change the exit code.
        mov rbx, rax;                          // save exit code
        mov rdi, rbx;                          // audit_commit_wrap arg = exit_code
        call cp_audit_commit_wrap;
        mov rax, rbx;                          // restore exit code

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
