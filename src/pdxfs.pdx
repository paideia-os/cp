// src/pdxfs.pdx -- cp v1.1-B (real-body trampolines + sys_getcwd)
// Pdxfs module: real-syscall trampolines for open/read/write/close/stat
// plus the sys_getcwd trampoline that v1.1-B uses for userspace
// resolution of the destination path against the task cwd.
//
// Scope (v1.1-B)
// --------------
// v1.1-A shipped five real syscall trampolines (open/read/write/close/
// stat) with no cwd resolution -- cp's caller-visible destination
// argv was passed to sys_open verbatim, and the kernel's `vfs_open`
// (R86.M1-005) anchored a slash-bearing relative destination against
// the caller's TASK_OFF_CWD for free. cp v1.1-B adds sys_getcwd so
// the copy body can resolve a slash-less destination in userspace
// BEFORE the O_CREAT sys_open call site -- see the paideia-os/cp#21
// discussion for the failure mode (`vfs_open_creat_scanned` refuses
// slash-less O_CREAT paths outright).
//
// This leaves six kernel syscalls cp uses for a simple file-to-file
// copy:
//
//   pdxfs_open   (path, flags, mode) -> fd or -errno        [sysno 2]
//   pdxfs_read   (fd, buf, len)      -> n or -errno         [sysno 0]
//   pdxfs_write  (fd, buf, len)      -> n or -errno         [sysno 1]
//   pdxfs_close  (fd)                -> 0 or -errno         [sysno 3]
//   pdxfs_stat   (path, statbuf)     -> 0 or -errno         [sysno 77]
//   pdxfs_getcwd (buf, buf_len)      -> bytes or -errno     [sysno 86]
//
// v1.1-A widens pdxfs_open's ring-3 surface from (path, flags) to
// (path, flags, mode) so the caller can preserve the source's POSIX
// mode word when creating the destination. v1.0 hard-wired mode=0
// which the substrate ignores today; when the substrate starts
// honouring mode (R25+, pdxfs-lite already does), an unmodified
// v1.0 destination would land at whatever backend-default the vnode
// layer picks -- v1.1-A lands the source's mode instead.
//
// Open flag conventions
// ---------------------
// Verified against src/kernel/core/fs/vfs_open.pdx (frozen since
// R16-M1-006 / #575):
//
//   O_RDONLY = 0        O_TRUNC  = 0x80  (bit 7)
//   O_WRONLY = 1        O_APPEND = 0x200 (bit 9)
//   O_RDWR   = 2        O_CREAT  = 0x40  (bit 6)
//
// The destination-side combined flag used by copy_bytes_only is
// O_WRONLY|O_CREAT|O_TRUNC = 0xC1 (NOT 0x241 -- 0x200 is APPEND).
//
// Error convention
// ----------------
// Every syscall in paideia-os returns a Linux-signed u64 on failure
// (bit 63 set). Callers use `cmp rax, 0; jl err` to branch on any
// error class in one instruction. Successful returns are always
// non-negative:
//   open  -> fd in [3, 32)
//   read  -> bytes_read in [0, len]  (0 == EOF)
//   write -> bytes_written in [0, len]
//   close -> 0
//   stat  -> 0 (statbuf filled per the 64-byte layout, sys_stat.pdx)
//
// paideia-as compliance (v0.36+)
// ------------------------------
//   - Module Pdxfs (PascalCase basename matches src/pdxfs.pdx).
//   - No test mnemonic. Leaf trampolines; no zero-check needed here.
//   - r11 is scratch; unused in every entry point (leaves).
//   - Leaf functions: no callee-save touched, no push/pop parity to
//     preserve.
//   - Every mov r,imm uses imm <= 0x7FFFFFFF (largest is 255 for
//     pdxfs_stat's path_len cap and 79 as a syscall id).

module Pdxfs = structure {

  // -- Syscall ids (mirror paideia-os src/kernel/core/syscall/dispatch.pdx) --
  pub let SYSCALL_READ   : u64 = 0
  pub let SYSCALL_WRITE  : u64 = 1
  pub let SYSCALL_OPEN   : u64 = 2
  pub let SYSCALL_CLOSE  : u64 = 3
  pub let SYSCALL_STAT   : u64 = 77
  pub let SYSCALL_GETCWD : u64 = 86    // R86.M1-003 (paideia-os #1956)

  // -- Open flag constants (mirror src/kernel/core/fs/vfs_open.pdx) --
  pub let O_RDONLY : u64 = 0
  pub let O_WRONLY : u64 = 1
  pub let O_RDWR   : u64 = 2
  pub let O_CREAT  : u64 = 0x40    // bit 6 -- vfs_open.pdx L36
  pub let O_TRUNC  : u64 = 0x80    // bit 7
  pub let O_APPEND : u64 = 0x200   // bit 9

  // Path-length walker cap for the arity-3 stat / mkdir syscalls in
  // paideia-os. 255 = SYS_STAT_PATH_MAX(256) - 1, matches the hardcode
  // in src/user/mkdir.pdx mkdir_use_default.
  pub let PATH_LEN_CAP : u64 = 255

  // ============================================================================
  // pdxfs_open(path_ptr, flags, mode) -> fd_or_errno
  //
  // Signature: pdxfs_open : (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): path_ptr -- VA of a NUL-terminated ASCII path
  // RSI (input): flags    -- bitmask (see O_* constants above)
  // RDX (input): mode     -- POSIX permission bits (ignored on read;
  //                           honoured on O_CREAT paths per backend)
  // RAX (output): fd on success; negative-errno u64 on failure.
  //
  // v1.1-A widens the M1 (path, flags) surface to (path, flags, mode)
  // so cp preserves the source's POSIX mode word when creating the
  // destination. The substrate at HEAD (2026-08-31) ignores the mode
  // arg on tmpfs but pdxfs-lite honours it; either way, forwarding the
  // caller's mode is the correct forward-compatible shape.
  //
  // Arity 3; no r10 shuffle. Leaf.
  // ============================================================================
  pub let pdxfs_open : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (path_ptr: u64) (flags: u64) (mode: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A pdxfs_open. Trampoline for paideia-os sysno 2 (sys_open). SysV arg1=rdi(path), arg2=rsi(flags), arg3=rdx(mode) map straight onto the SYSCALL arg registers (arity 3 < 4, no r10 shuffle). Return value is verbatim from the syscall: fd on success (in [3, 32)) or a negative-errno u64 (SYS_OPEN_ERR_ENOENT = -2, SYS_OPEN_ERR_EMFILE = -24). v1.1-A widens the M1 arity-2 shape to arity-3 so the caller can preserve the source's mode when creating the destination (v1.0 hard-wired mode=0). Leaf; sysreg effect for the SYSCALL clobber (rcx, r11).",
      block: {
        mov rax, 2;                            // SYSCALL_OPEN
        syscall;
        ret
      }
    }

  // ============================================================================
  // pdxfs_read(fd, buf_ptr, len) -> bytes_or_errno
  //
  // Signature: pdxfs_read : (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): fd      -- file descriptor in [3, 32)
  // RSI (input): buf_ptr -- destination buffer VA
  // RDX (input): len     -- bytes to read
  // RAX (output): bytes_read in [0, len] on success (0 == EOF); or
  //               negative-errno u64 on failure.
  //
  // Arity 3; no r10 shuffle. Leaf.
  // ============================================================================
  pub let pdxfs_read : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (fd: u64) (buf_ptr: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A pdxfs_read. Trampoline for paideia-os sysno 0 (sys_read). SysV arg1=rdi(fd), arg2=rsi(buf), arg3=rdx(len) map straight onto SYSCALL arg registers. Return value verbatim: bytes_read in [0, len] on success (0 == EOF is a valid non-error return the caller uses as its loop-exit condition); negative-errno u64 on failure (SYS_READ_ERR_EBADF = -9, SYS_READ_ERR_EIO = -5). Leaf; sysreg effect for the SYSCALL clobber.",
      block: {
        mov rax, 0;                            // SYSCALL_READ
        syscall;
        ret
      }
    }

  // ============================================================================
  // pdxfs_write(fd, buf_ptr, len) -> bytes_or_errno
  //
  // Signature: pdxfs_write : (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): fd      -- file descriptor in [3, 32)
  // RSI (input): buf_ptr -- source buffer VA
  // RDX (input): len     -- bytes to write
  // RAX (output): bytes_written in [0, len] on success (short write
  //               possible on quota); negative-errno on failure.
  //
  // Arity 3. Leaf.
  // ============================================================================
  pub let pdxfs_write : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (fd: u64) (buf_ptr: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A pdxfs_write. Trampoline for paideia-os sysno 1 (sys_write). SysV arg1=rdi(fd), arg2=rsi(buf), arg3=rdx(len) map straight onto SYSCALL arg registers. Return value verbatim: bytes_written in [0, len] on success (short-write is a legal non-error return the caller must handle); negative-errno u64 on failure. Leaf; sysreg effect for the SYSCALL clobber.",
      block: {
        mov rax, 1;                            // SYSCALL_WRITE
        syscall;
        ret
      }
    }

  // ============================================================================
  // pdxfs_close(fd) -> 0_or_errno
  //
  // Signature: pdxfs_close : (u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): fd -- file descriptor in [3, 32)
  // RAX (output): 0 on success; SYS_CLOSE_ERR_EBADF (-9) on invalid fd.
  //
  // Arity 1. Leaf.
  // ============================================================================
  pub let pdxfs_close : (u64) -> u64 !{mem, sysreg} @{} =
    fn (fd: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A pdxfs_close. Trampoline for paideia-os sysno 3 (sys_close). Arity 1; no register shuffle. Return: 0 on success, SYS_CLOSE_ERR_EBADF = -9 on invalid fd. cp's copy body ignores the return in the normal-exit path (any close error is a driver-level anomaly out of cp's control; the fd is released either way at task teardown). Leaf; sysreg effect for the SYSCALL clobber.",
      block: {
        mov rax, 3;                            // SYSCALL_CLOSE
        syscall;
        ret
      }
    }

  // ============================================================================
  // pdxfs_stat(path_ptr, statbuf_ptr) -> 0_or_errno
  //
  // Signature: pdxfs_stat : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): path_ptr    -- VA of a NUL-terminated path
  // RSI (input): statbuf_ptr -- VA of a caller-owned 64-byte statbuf
  //                              (frozen layout: sys_stat.pdx §Layout)
  // RAX (output): 0 on success (statbuf filled), or a negative-errno
  //               u64 on failure (-ENOENT = -2, -EFAULT = -14).
  //
  // The kernel's sys_stat ring-3 shape is (path_va, path_len,
  // stat_buf_va) but the trampoline keeps a two-arg external surface
  // (path, statbuf) and passes 255 for path_len (walker CAP, matches
  // the src/user/mkdir.pdx convention). The mode field lives at
  // statbuf+24 as a u32; size at +8 as a u64.
  //
  // Arity 3 after the shuffle; no r10 shuffle needed (arity < 4).
  // Leaf.
  // ============================================================================
  pub let pdxfs_stat : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (path_ptr: u64) (statbuf_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-A pdxfs_stat. Trampoline for paideia-os sysno 77 (sys_stat) landed by R56.M3-002 (#1791). Ring-3 shape rdi=path_va, rsi=path_len, rdx=stat_buf_va; caller's two-arg shape (path, statbuf) is shuffled into place by grabbing statbuf_ptr from rsi into rdx BEFORE rsi is overwritten with 255 (path_len cap -- walker hint, not exact strlen; sys_stat_body walks the NUL-terminated path itself under the cap). Return: 0 on success (statbuf filled per the frozen 64-byte layout: ino u64@+0, size u64@+8, mtime u64@+16, mode u32@+24, nlink u32@+28, ...), SYS_STAT_ERR_ENOENT (-2) or SYS_STAT_ERR_EFAULT (-14) on failure. Leaf; sysreg effect for the SYSCALL clobber. The shuffle order is critical: mov rdx,rsi FIRST (grab statbuf before rsi is clobbered), then mov rsi,255 (walker cap).",
      block: {
        mov rdx, rsi;                          // statbuf_ptr (grab first)
        mov rsi, 255;                          // path_len cap (walker hint)
        mov rax, 77;                           // SYSCALL_STAT
        syscall;
        ret
      }
    }

  // ============================================================================
  // pdxfs_getcwd(buf_va, buf_len) -> bytes_or_errno
  //
  // Signature: pdxfs_getcwd : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): buf_va  -- VA of a caller-owned scratch buffer
  // RSI (input): buf_len -- capacity of the buffer in bytes
  // RAX (output): bytes written INCLUDING the trailing NUL on success
  //               (POSIX getcwd(3) convention: rax-1 is the strlen),
  //               or a negative-errno u64 on failure (-EFAULT = -14,
  //               -ERANGE = -34, -ENOENT = -2).
  //
  // v1.1-B adds this trampoline so copy_bytes_only can resolve a
  // slash-less destination path against the task's cwd BEFORE the
  // O_CREAT sys_open call site. The kernel's vfs_open O_CREAT
  // parent-scan (src/kernel/core/fs/vfs_open.pdx, label
  // `vfs_open_creat_scanned`) refuses a path with no '/' outright --
  // paideia-os/cp#21. Landing the resolve in userspace matches the
  // mkdir v1.1-B precedent (paideia-os/mkdir#25) and is forward-
  // compatible with a future backend adapter that does not honour
  // TASK_OFF_CWD.
  //
  // Arity 2; no r10 shuffle. Leaf.
  // ============================================================================
  pub let pdxfs_getcwd : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (buf_va: u64) (buf_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "cp v1.1-B pdxfs_getcwd. Trampoline for paideia-os sysno 86 (sys_getcwd) landed by R86.M1-003 (#1956) at src/kernel/core/syscall/sys_getcwd.pdx. SysV arg1=rdi(buf_va), arg2=rsi(buf_len) map straight onto SYSCALL arg registers (arity 2 < 4, no r10 shuffle). Return value verbatim from the syscall: bytes written INCLUDING the trailing NUL on success (POSIX getcwd(3) convention; rax-1 is the strlen), or negative-errno u64 on failure (-EFAULT=-14 for a bad buf_va, -ERANGE=-34 for buf_len < required, -ENOENT=-2 for an unlinked cwd entry). Consumed by Copy::copy_resolve_dst_cwd for the O_CREAT parent-resolve gap (paideia-os/cp#21) -- the mkdir v1.1-B userspace-resolve precedent (paideia-os/mkdir#25) is the shape reference. Leaf; sysreg effect for the SYSCALL clobber (rcx, r11).",
      block: {
        mov rax, 86;                           // SYSCALL_GETCWD
        syscall;
        ret
      }
    }
}
