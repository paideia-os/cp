# cp -- caps.decl
#
# Wave: R50
# Milestone: v1.1-A (real body extraction)
#
# cp copies a source file to a destination via five kernel syscalls:
# sys_open, sys_read, sys_write, sys_close, sys_stat. Its v1.1-A
# caps.decl declares the MINIMUM cap set every invocation receives
# from the loader's InitCap sidecar.
#
# v1.1-A retires the v1.0 M1-001 STUB cap surface:
#
#   KIND_IPC_ENDPOINT (invoke)              -- pipe substrate; retired
#                                              with libpdx-semantic-pipe.
#   KIND_PDXFS_TXN (invoke)                 -- retired with the outer
#                                              txn wrap.
#   KIND_ELEVATE_CHANNEL (invoke,           -- retired with the cross-
#     svc.elevate-broker)                      subtree elevate retry.
#
# Every one of those was a shape-in-place hook against a substrate
# that has not landed. v1.1-A declares only what the real body
# actually uses.
#
# Format: `requires:` lists cap-kind names + narrowed rights + optional
# scope. The caps-decl reader resolves each name to its KIND_* ordinal
# at exec time, matches the loader-seeded cap set against this list,
# and fails-fast with CAP_MANIFEST_MISSING / CAP_MANIFEST_EXTRA if the
# two do not agree.
requires:
  # Identity root. KIND_USER = 0x190 (R48.M1 substrate at
  # src/kernel/core/cap/kind_user.pdx). Present so the invoker
  # identity is available for future audit journal correlation once
  # libpdx-audit re-lands cleanly.
  - KIND_USER (self)

  # Read authority on the source subtree. Narrowed to READ (no write).
  # The actual source path is a per-invocation argument; the loader
  # narrows the cap tail's subtree to the argument-path prefix at exec.
  # KIND_PDXFS_FILE = 0x195 (R42 substrate, landed in paideia-os commit
  # 411ad0e).
  - KIND_PDXFS_FILE (read, <src>)

  # Write authority on the destination-parent subtree. Same narrowing
  # discipline: the loader restricts the cap tail to the destination-
  # parent path prefix at exec so cp cannot write outside the argument.
  - KIND_PDXFS_FILE (write, <dst-parent>)

# Declared output schemas -- the semantic-pipe schema records this tool
# emits on its stdout. v1.1-A emits none (single-file copy is silent on
# success, prints on stderr on error). A future milestone re-introduces
# CopyProgressRecord[] via libpdx-semantic-pipe once the substrate is
# stable enough to justify carrying the dep.
declares_output_schemas: (none)
